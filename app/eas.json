      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://prologue-backend-staging.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "image": "latest"
