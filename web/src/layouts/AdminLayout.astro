---
import '../styles/global.css';

// 어드민 공용 셸 — 로그인(이메일 인증코드)·API 헬퍼·사이드바 내비를 제공한다.
// 각 페이지는 패널 내용 마크업과 window.pageLoad()만 구현하면 된다.
// 데스크톱은 왼쪽 사이드바, 좁은 화면은 위 탭바 — 운영 도구다운 밀도와 위계를 준다.
const API_BASE = 'https://api.prologue.day';
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';
const tabs = [
  { href: '/admin', label: '대시보드' },
  { href: '/admin/questions', label: '질문' },
  { href: '/admin/answers', label: '문답' },
  { href: '/admin/photos', label: '사진 검수' },
  { href: '/admin/reports', label: '신고' },
  { href: '/admin/members', label: '회원' },
  { href: '/admin/ink', label: '잉크' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 프롤로그 어드민</title>
    <!-- 운영 도구 — 색인·리퍼러 전달을 막는다 -->
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.png" />
  </head>
  <body class="admin-body admin-locked">
    <aside class="admin-side">
      <a class="admin-brand" href="/admin">
        <img src="/brand-mark.png" alt="" width="26" height="19" />
        <span>프롤로그 <em>어드민</em></span>
      </a>
      <nav class="admin-nav">
        {tabs.map((t) => (
          <a href={t.href} class:list={['admin-tab', { active: path === t.href }]}>{t.label}</a>
        ))}
      </nav>
      <a class="admin-side-foot" href="/" target="_blank" rel="noopener">prologue.day ↗</a>
    </aside>

    <main class="admin-main">
      <!-- 로그인 — 앱과 같은 이메일 인증코드 방식. 이때는 사이드바를 감춰(body.admin-locked)
           메뉴 구성을 광고하지 않고, 카드 하나만 화면 정중앙에 둔다. -->
      <section id="login" class="admin-login" hidden>
        <div class="admin-card admin-login-card">
          <img src="/brand-mark.png" alt="" width="42" height="30" class="admin-login-mark" />
          <h2 class="admin-sub">프롤로그 어드민</h2>
          <p class="admin-desc">어드민 권한이 있는 계정의 이메일로 인증해 주세요.</p>
          <div class="admin-field">
            <input id="email" type="email" placeholder="이메일" autocomplete="email" />
            <button type="button" class="admin-btn ghost" id="send-code">코드 받기</button>
          </div>
          <div class="admin-field" id="code-row" hidden>
            <input id="code" inputmode="numeric" maxlength="6" placeholder="6자리 코드" />
            <button type="button" class="admin-btn" id="verify">로그인</button>
          </div>
          <p class="admin-msg" id="login-msg"></p>
        </div>
      </section>

      <section id="panel" hidden>
        <div class="admin-panel-head">
          <h2 class="admin-sub">{title}</h2>
          <div class="admin-panel-actions">
            <button type="button" class="admin-btn ghost small" id="refresh">새로고침</button>
            <button type="button" class="admin-btn ghost small" id="logout">로그아웃</button>
          </div>
        </div>
        <slot />
      </section>
    </main>

    <script is:inline define:vars={{ API_BASE }}>
      const $ = (id) => document.getElementById(id);
      const TOKEN_KEY = 'pl_admin_token';
      const REFRESH_KEY = 'pl_admin_refresh';
      let token = localStorage.getItem(TOKEN_KEY) || '';
      let refreshToken = localStorage.getItem(REFRESH_KEY) || '';

      function rawFetch(path, options = {}) {
        return fetch(API_BASE + path, {
          ...options,
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: 'Bearer ' + token } : {}),
          },
        });
      }

      // 액세스 토큰은 30분짜리 — 만료로 거부되면 리프레시(14일) 한 번으로 조용히 갱신하고 재시도한다.
      // 갱신까지 실패했을 때만 로그인 화면으로 보낸다.
      async function api(path, options = {}) {
        let res = await rawFetch(path, options);
        if ((res.status === 401 || res.status === 403) && refreshToken && (await tryRefresh())) {
          res = await rawFetch(path, options);
        }
        if (res.status === 401 || res.status === 403) {
          throw Object.assign(new Error('권한이 없거나 세션이 만료됐어요.'), { auth: true });
        }
        const data = await res.json().catch(() => null);
        if (!res.ok) throw new Error((data && data.message) || 'HTTP ' + res.status);
        return data;
      }

      async function tryRefresh() {
        try {
          const res = await fetch(API_BASE + '/auth/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refreshToken }),
          });
          if (!res.ok) return false;
          const data = await res.json();
          token = data.accessToken;
          refreshToken = data.refreshToken || refreshToken;
          localStorage.setItem(TOKEN_KEY, token);
          localStorage.setItem(REFRESH_KEY, refreshToken);
          return true;
        } catch {
          return false;
        }
      }

      function showLogin(msg) {
        token = '';
        refreshToken = '';
        localStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem(REFRESH_KEY);
        document.body.classList.add('admin-locked'); // 사이드바·메뉴를 감춘다
        $('panel').hidden = true;
        $('login').hidden = false;
        $('login-msg').textContent = msg || '';
      }

      async function showPanel() {
        document.body.classList.remove('admin-locked');
        $('login').hidden = true;
        $('panel').hidden = false;
        if (window.pageLoad) await window.pageLoad();
      }

      // 페이지 스크립트가 쓰는 공용 훅
      window.admin = { $, api, showLogin };

      $('send-code').addEventListener('click', async () => {
        const email = $('email').value.trim();
        if (!email) return;
        $('send-code').disabled = true;
        try {
          await api('/auth/email/request-code', { method: 'POST', body: JSON.stringify({ email }) });
          $('code-row').hidden = false;
          $('login-msg').textContent = '메일로 6자리 코드를 보냈어요.';
          $('code').focus();
        } catch (e) {
          $('login-msg').textContent = e.message;
        } finally {
          $('send-code').disabled = false;
        }
      });

      $('verify').addEventListener('click', async () => {
        const email = $('email').value.trim();
        const code = $('code').value.trim();
        if (!email || !/^\d{6}$/.test(code)) {
          $('login-msg').textContent = '이메일과 6자리 코드를 확인해 주세요.';
          return;
        }
        $('verify').disabled = true;
        try {
          const data = await api('/auth/email/verify', { method: 'POST', body: JSON.stringify({ email, code }) });
          token = data.accessToken;
          refreshToken = data.refreshToken || '';
          localStorage.setItem(TOKEN_KEY, token);
          if (refreshToken) localStorage.setItem(REFRESH_KEY, refreshToken);
          await showPanel();
        } catch (e) {
          $('login-msg').textContent = e.message;
        } finally {
          $('verify').disabled = false;
        }
      });

      $('refresh').addEventListener('click', () => window.pageLoad && window.pageLoad());
      $('logout').addEventListener('click', () => showLogin(''));

      if (token) showPanel();
      else showLogin('');
    </script>

    <style is:global>
      /* 운영 도구는 멋 부리지 않는다 — 시스템 글씨체, 낮은 채도, 정보 밀도. */
      .admin-body,
      .admin-body h1,
      .admin-body h2 {
        font-family:
          -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
      }
      .admin-body {
        min-height: 100vh;
        display: flex;
        background: var(--paper);
      }
      /* display를 지정한 클래스가 [hidden]의 display:none을 덮어쓴다(로그인 카드가 안 사라지던 버그).
         어드민 안에서는 hidden이 항상 이기게 못박는다. */
      .admin-body [hidden] {
        display: none !important;
      }

      /* ── 사이드바 ── */
      .admin-side {
        width: 216px;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 22px 14px;
        border-right: 1px solid var(--border);
        background: var(--surface);
      }
      .admin-brand {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 4px 10px 18px;
        font-size: 15px;
        font-weight: 800;
        color: var(--ink);
        text-decoration: none;
        letter-spacing: -0.2px;
      }
      .admin-brand em {
        font-style: normal;
        color: var(--terracotta-strong);
      }
      .admin-nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .admin-tab {
        padding: 9px 10px;
        font-size: 14px;
        border-radius: 9px;
        color: var(--muted);
        text-decoration: none;
      }
      .admin-tab:hover {
        color: var(--ink);
        background: var(--paper);
      }
      .admin-tab.active {
        color: var(--terracotta-strong);
        background: color-mix(in srgb, var(--terracotta) 10%, transparent);
        font-weight: 700;
      }
      .admin-side-foot {
        margin-top: auto;
        padding: 10px;
        font-size: 12px;
        color: var(--muted);
        text-decoration: none;
      }
      .admin-side-foot:hover {
        color: var(--terracotta-strong);
      }

      /* ── 본문 ── */
      .admin-main {
        flex: 1;
        min-width: 0;
        max-width: 980px;
        padding: 28px 32px 64px;
      }
      .admin-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }
      .admin-sub {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.3px;
      }
      .admin-panel-actions {
        display: flex;
        gap: 6px;
      }
      .admin-desc {
        color: var(--muted);
        font-size: 13.5px;
        line-height: 1.55;
        margin: 6px 0 16px;
      }

      /* ── 로그인 — 잠긴 동안(body.admin-locked)은 사이드바 없이 카드 하나만 정중앙 ── */
      .admin-locked .admin-side {
        display: none;
      }
      .admin-locked .admin-main {
        max-width: none;
        padding: 0;
      }
      .admin-login {
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 24px;
      }
      .admin-login-card {
        width: min(420px, 100%);
        padding: 30px 28px;
      }
      .admin-login-mark {
        display: block;
        margin-bottom: 14px;
      }

      /* ── 카드·리스트 ── */
      .admin-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 1px 2px rgba(16, 24, 32, 0.04);
      }
      .admin-list {
        padding: 6px 22px;
        color: var(--muted);
        font-size: 14px;
      }
      .admin-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 0;
      }
      .admin-row + .admin-row {
        border-top: 1px solid var(--border);
      }
      .admin-row-info {
        flex: 1;
        min-width: 0;
      }
      .admin-row-name {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        color: var(--ink);
        font-weight: 700;
        font-size: 14.5px;
      }
      .admin-row-url {
        display: block;
        color: var(--terracotta-strong);
        font-size: 13px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-decoration: underline;
      }
      .admin-row-date {
        color: var(--muted);
        font-size: 12.5px;
        margin-top: 3px;
      }
      .admin-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
      }
      .admin-snapshot {
        color: var(--ink);
        font-size: 13.5px;
        line-height: 1.55;
        margin-top: 4px;
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 4.6em;
        overflow: hidden;
      }
      .admin-status-done {
        color: var(--muted);
        font-size: 13px;
      }

      /* ── 상태 배지 — 상태는 글자색이 아니라 배지가 입는다 ── */
      .admin-badge {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0;
        background: var(--paper);
        border: 1px solid var(--border);
        color: var(--muted);
      }
      .admin-badge.ok {
        background: color-mix(in srgb, #2e9e5b 10%, transparent);
        border-color: color-mix(in srgb, #2e9e5b 30%, transparent);
        color: #227945;
      }
      .admin-badge.warn {
        background: color-mix(in srgb, var(--terracotta) 12%, transparent);
        border-color: color-mix(in srgb, var(--terracotta) 35%, transparent);
        color: var(--terracotta-strong);
      }

      /* ── 입력·버튼 ── */
      .admin-field {
        display: flex;
        gap: 8px;
        margin-top: 10px;
      }
      .admin-field input {
        flex: 1;
        height: 42px;
        padding: 0 14px;
        font-size: 14.5px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface);
        color: var(--ink);
      }
      .admin-field input:focus {
        outline: 2px solid color-mix(in srgb, var(--terracotta) 45%, transparent);
        outline-offset: 0;
        border-color: var(--terracotta);
      }
      .admin-search {
        margin: 0 0 14px;
      }
      .admin-btn {
        height: 42px;
        padding: 0 18px;
        border: 0;
        border-radius: 10px;
        background: var(--terracotta);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
      }
      .admin-btn:hover {
        background: var(--terracotta-strong);
      }
      .admin-btn.ghost {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--ink);
      }
      .admin-btn.ghost:hover {
        background: var(--paper);
        color: var(--terracotta-strong);
      }
      .admin-btn.small {
        height: 32px;
        padding: 0 12px;
        font-size: 12.5px;
        border-radius: 8px;
      }
      .admin-btn:disabled {
        opacity: 0.5;
        cursor: default;
      }
      .admin-msg {
        color: var(--muted);
        font-size: 13px;
        margin-top: 12px;
        min-height: 1.2em;
      }
      .admin-amount {
        width: 58px;
        height: 32px;
        text-align: center;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--ink);
        font-size: 13.5px;
      }

      /* ── 대시보드 스탯 타일 ── */
      .admin-stats {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
      }
      .admin-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 1px 2px rgba(16, 24, 32, 0.04);
      }
      .admin-stat-value {
        color: var(--ink);
        font-size: 28px;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.5px;
      }
      .admin-stat-value.alert {
        color: var(--terracotta-strong);
      }
      .admin-stat-label {
        color: var(--muted);
        font-size: 13px;
        margin-top: 2px;
      }
      .admin-stat-hint {
        color: var(--muted);
        font-size: 12px;
        margin-top: 6px;
      }

      /* ── 사진 검수 그리드 ── */
      .admin-photo-card {
        margin-bottom: 12px;
      }
      .admin-photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 10px;
        margin-top: 12px;
      }
      .admin-photo-cell {
        position: relative;
      }
      .admin-photo-cell img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--paper);
      }
      .admin-photo-remove {
        position: absolute;
        right: 6px;
        bottom: 6px;
        height: 28px;
        padding: 0 10px;
        border: 0;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        font-size: 12px;
        cursor: pointer;
      }

      /* ── 좁은 화면 — 사이드바가 위 탭바로 접힌다 ── */
      @media (max-width: 840px) {
        .admin-body {
          flex-direction: column;
        }
        .admin-side {
          width: 100%;
          height: auto;
          position: static;
          flex-direction: row;
          align-items: center;
          gap: 8px;
          padding: 12px 16px;
          border-right: 0;
          border-bottom: 1px solid var(--border);
        }
        .admin-brand {
          padding: 0 6px 0 0;
          white-space: nowrap;
        }
        .admin-nav {
          flex-direction: row;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }
        .admin-tab {
          padding: 7px 10px;
          white-space: nowrap;
          font-size: 13.5px;
        }
        .admin-side-foot {
          display: none;
        }
        .admin-main {
          padding: 20px 16px 48px;
        }
        .admin-row {
          flex-direction: column;
          align-items: stretch;
        }
        .admin-row-actions {
          justify-content: flex-end;
        }
      }
    </style>
  </body>
</html>
