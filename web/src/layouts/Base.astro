---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '프롤로그 — 하루 한 문답, 가치관 블라인드 소개팅',
  description = '하루 한 문답으로 알아가는, 가치관이 꼭 맞는 소중한 인연. 가치관 블라인드 소개팅, 프롤로그.',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title="프롤로그 스토리" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="header-brand">
          <img src="/brand-mark.png" alt="" />
          프롤로그
        </a>
        <nav class="header-nav">
          <a href="/story">스토리</a>
          <a href="/#download" class="cta">앱 다운로드</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div>© {new Date().getFullYear()} 프롤로그 · prologue.kr.team@gmail.com</div>
        <nav>
          <a href="/terms">이용약관</a>
          <a href="/privacy">개인정보처리방침</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
