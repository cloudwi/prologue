---
import Base from '../layouts/Base.astro';
import { API_BASE, SITE_URL } from '../lib/site';

/*
 * 모임장 콘솔 — 모임을 열고, 누가 왔는지 보고, 오픈채팅으로 건너가는 자리.
 *
 * 앱이 아니라 웹인 이유는 V37 마이그레이션 첫 줄에 이미 있다 — "모임장이 웹(/host)에서
 * 만들고, 회원이 앱에서 신청한다". 모임장은 소개받으러 온 사람이 아니라 자리를 여는 사람이라
 * 소개팅 프로필을 요구할 이유가 없고, 개설은 사진과 긴 글과 주소를 다루는 폼 작업이다.
 *
 * 화면을 둘로 나눈다. 왼쪽은 손이 움직이는 곳, 오른쪽은 그 결과가 폰에서 어떻게 보이는지다.
 * 모임장은 앱에 들어오기 어렵다 — 소개팅 온보딩을 거쳐야 자기 모임을 볼 수 있으니까.
 * 그래서 참여자가 보는 화면을 여기서 대신 보여준다. 적으면서 바로 확인할 수 있어야
 * "이 사진이 잘렸나", "제목이 두 줄로 넘어가나" 같은 것을 다 만들고 나서 알지 않는다.
 *
 * 오른쪽 미리보기는 두 가지다. 이미 연 모임은 서버가 그리는 진짜 초대장(/m/{id})을 그대로
 * 끼워 넣는다 — 흉내가 아니라 참여자가 보는 바로 그 페이지다. 아직 만들기 전에는 폼의 값으로
 * 카드와 초대장을 그려 보여준다.
 */
---

<Base title="모임장 콘솔 — 프롤로그" description="프롤로그 모임을 열고 신청자를 확정합니다." noindex>
  <section class="console">
    <div class="wide">
      <!-- 로그인 — 앱과 같은 이메일 인증코드. 이 서비스에 비밀번호는 없다. -->
      <div class="gate" id="gate">
        <div class="gate-card">
          <h1>모임 열기</h1>
          <p class="lead">모임을 만들고, 신청한 사람을 확인하고, 오픈채팅으로 안내하는 자리예요.</p>
          <label class="field"><span>이메일</span>
            <input id="email" type="email" inputmode="email" autocomplete="email" placeholder="name@example.com" />
          </label>
          <div class="field" id="codeField" hidden><span>인증코드</span>
            <input id="code" type="text" inputmode="numeric" maxlength="6" placeholder="6자리" />
          </div>
          <button class="btn block" id="loginBtn">인증코드 받기</button>
          <p class="hint" id="loginHint">가입하실 때 쓰신 이메일을 넣어주세요.</p>
        </div>
      </div>

      <!-- 콘솔 본체 -->
      <div class="split" id="app" hidden>
        <!-- 왼쪽 : 손이 움직이는 곳 -->
        <div class="pane left">
          <header class="pane-head">
            <div>
              <h1 id="paneTitle">내 모임</h1>
              <p class="lead" id="paneLead">연 모임과 신청한 사람들이 여기 모여요.</p>
            </div>
            <div class="head-actions">
              <button class="btn small" id="newBtn">새 모임</button>
              <button class="btn ghost small" id="logoutBtn">로그아웃</button>
            </div>
          </header>

          <div id="v-list"><div id="list"></div></div>

          <div id="v-detail" hidden>
            <button class="back" id="backFromDetail">← 내 모임</button>
            <div id="detail"></div>
          </div>

          <div id="v-new" hidden>
            <button class="back" id="backFromNew">← 내 모임</button>
            <div class="form">
              <label class="field"><span>모임 이름 *</span><input id="f-title" maxlength="80" placeholder="밑줄 모임 · 서로서가" /></label>
              <label class="field"><span>소개</span><textarea id="f-desc" rows="4" maxlength="1000" placeholder="어떤 자리인지, 어떤 분이 오면 좋을지 적어주세요."></textarea></label>
              <div class="grid2">
                <label class="field"><span>날짜 *</span><input id="f-date" type="date" /></label>
                <label class="field"><span>시간 *</span><input id="f-time" type="time" step="900" /></label>
              </div>
              <label class="field"><span>주소</span><input id="f-address" placeholder="서울 서초구 언남길 49" /></label>
              <label class="field"><span>장소 이름 * <em>건물·층·가게까지</em></span><input id="f-place" maxlength="120" placeholder="1층 파란지붕 서로서가" /></label>
              <div class="grid2">
                <label class="field"><span>정원 * <em>2~100</em></span><input id="f-capacity" type="number" min="2" max="100" value="8" /></label>
                <label class="field"><span>참가비 <em>원</em></span><input id="f-fee" type="number" min="0" step="1000" value="0" /></label>
              </div>
              <label class="field"><span>여성 참가비 <em>비우면 위와 같음</em></span><input id="f-feeFemale" type="number" min="0" step="1000" /></label>
              <label class="field"><span>오픈채팅 링크 * <em>신청한 사람에게만 보여요</em></span><input id="f-kakao" placeholder="https://open.kakao.com/o/..." /></label>
              <label class="field"><span>커버 사진 <em>첫 장이 초대장의 얼굴이에요</em></span><input id="f-cover" type="file" accept="image/*" multiple /></label>
              <div id="coverPreview" class="covers"></div>
              <label class="check"><input id="f-jobVerified" type="checkbox" /> <span>직장 인증한 분만 신청할 수 있어요</span></label>
              <button class="btn block" id="createBtn">모임 열기</button>
            </div>
          </div>

          <p class="msg" id="msg" hidden></p>
        </div>

        <!-- 오른쪽 : 참여자가 보는 화면 -->
        <div class="pane right">
          <div class="preview-head">
            <span id="previewLabel">참여자에게 보이는 화면</span>
            <div class="tabs" id="previewTabs" hidden>
              <button class="tab on" data-view="card">모임 탭</button>
              <button class="tab" data-view="detail">모임 상세</button>
            </div>
          </div>
          <div class="phone">
            <div class="screen" id="screen">
              <div class="empty-preview">왼쪽에서 모임을 고르거나 만들면<br />여기에 폰 화면이 나타나요.</div>
            </div>
          </div>
          <p class="phone-note" id="phoneNote"></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ API_BASE, SITE_URL }}>
  const $ = (id) => document.getElementById(id);
  const TOKEN_KEY = 'prologue.host.token';
  let token = localStorage.getItem(TOKEN_KEY) || '';
  let meetups = [];
  let current = null;
  let covers = [];
  let previewView = 'card';

  const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const won = (n) => Number(n || 0).toLocaleString('ko-KR');

  const say = (t, bad = false) => {
    const el = $('msg');
    el.hidden = !t;
    el.textContent = t || '';
    el.className = bad ? 'msg bad' : 'msg';
  };

  const view = (name) => {
    for (const v of ['list', 'detail', 'new']) $(`v-${v}`).hidden = v !== name;
  };

  async function api(path, { method = 'GET', body, raw } = {}) {
    const headers = { ...(token ? { Authorization: `Bearer ${token}` } : {}) };
    if (body && !raw) headers['Content-Type'] = 'application/json';
    const res = await fetch(`${API_BASE}${path}`, { method, headers, body: raw ? body : body ? JSON.stringify(body) : undefined });
    const text = await res.text();
    const data = text ? JSON.parse(text) : null;
    if (res.status === 401) { logout(); throw new Error('다시 로그인해 주세요'); }
    if (!res.ok) throw new Error(data?.message || `요청이 실패했어요 (${res.status})`);
    return data;
  }

  function logout() {
    localStorage.removeItem(TOKEN_KEY);
    token = '';
    $('gate').hidden = false;
    $('app').hidden = true;
  }
  $('logoutBtn').onclick = logout;

  // ── 로그인 ──────────────────────────────────────────────
  let codeSent = false;
  $('loginBtn').onclick = async () => {
    const email = $('email').value.trim();
    if (!email) return say('이메일을 적어주세요', true);
    try {
      if (!codeSent) {
        await api('/auth/email/request-code', { method: 'POST', body: { email } });
        codeSent = true;
        $('codeField').hidden = false;
        $('loginBtn').textContent = '들어가기';
        $('loginHint').textContent = '메일로 보낸 6자리를 넣어주세요.';
        $('code').focus();
        return;
      }
      const code = $('code').value.trim();
      if (!code) return alert('인증코드를 넣어주세요');
      const r = await api('/auth/email/verify', { method: 'POST', body: { email, code } });
      token = r.accessToken;
      localStorage.setItem(TOKEN_KEY, token);
      $('gate').hidden = true;
      $('app').hidden = false;
      await loadList();
    } catch (e) {
      alert(e.message);
    }
  };

  // ── 날짜 ────────────────────────────────────────────────
  const dfLong = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', weekday: 'short' });
  const tf = (d) => {
    const h = d.getHours();
    return `${h < 12 ? '오전' : '오후'} ${h % 12 === 0 ? 12 : h % 12}:${String(d.getMinutes()).padStart(2, '0')}`;
  };
  const numeral = (d) => `${d.getFullYear()}. ${String(d.getMonth() + 1).padStart(2, '0')}. ${String(d.getDate()).padStart(2, '0')}`;
  const dday = (d) => {
    const a = new Date(); a.setHours(0, 0, 0, 0);
    const b = new Date(d); b.setHours(0, 0, 0, 0);
    const diff = Math.round((b - a) / 86400000);
    return diff === 0 ? '오늘 열리는 모임이에요' : diff > 0 ? `모임까지 ${diff}일 남았어요` : `${-diff}일 전에 열린 모임이에요`;
  };
  const STATUS = { OPEN: '모집 중', CLOSED: '모집 마감', DONE: '개최 완료', CANCELED: '취소됨' };

  // ── 목록 ────────────────────────────────────────────────
  async function loadList() {
    const r = await api('/meetups/mine');
    meetups = r.meetups || [];
    $('paneTitle').textContent = '내 모임';
    $('paneLead').textContent = '연 모임과 신청한 사람들이 여기 모여요.';
    $('list').innerHTML = meetups.length === 0
      ? `<div class="blank"><strong>아직 연 모임이 없어요.</strong><span>‘새 모임’으로 첫 자리를 만들어보세요.</span></div>`
      : meetups.map((m) => {
          const waiting = (m.applications || []).filter((a) => a.status === 'APPLIED').length;
          const d = new Date(m.meetAt);
          return `<button class="card" data-open="${m.meetupId}">
            ${m.coverUrls?.[0] ? `<img class="thumb" src="${esc(m.coverUrls[0])}" alt="" />` : '<div class="thumb blank-thumb"></div>'}
            <div class="card-body">
              <strong>${esc(m.title)}</strong>
              <span class="meta">${dfLong.format(d)} ${tf(d)} · ${esc(m.place)}</span>
              <span class="tags">
                <em class="tag ${m.status === 'OPEN' ? 'on' : ''}">${STATUS[m.status] || m.status}</em>
                <em class="tag">확정 ${m.confirmedCount}/${m.capacity}</em>
                ${waiting ? `<em class="tag warn">기다리는 신청 ${waiting}</em>` : ''}
              </span>
            </div>
          </button>`;
        }).join('');
    for (const b of $('list').querySelectorAll('[data-open]')) b.onclick = () => openDetail(b.dataset.open);
    view('list');
    say('');
    if (meetups.length) preview(meetups[0]);
  }

  // ── 모임 하나 ───────────────────────────────────────────
  function openDetail(id) {
    current = meetups.find((m) => m.meetupId === id);
    if (!current) return;
    $('paneTitle').textContent = current.title;
    const d = new Date(current.meetAt);
    $('paneLead').textContent = `${dfLong.format(d)} ${tf(d)} · ${current.place}`;
    renderDetail();
    view('detail');
    preview(current);
  }

  function renderDetail() {
    const m = current;
    const apps = (m.applications || []).filter((a) => a.status !== 'CANCELED');
    const waiting = apps.filter((a) => a.status === 'APPLIED');
    const confirmed = apps.filter((a) => a.status === 'CONFIRMED');
    const declined = apps.filter((a) => a.status === 'DECLINED');

    const person = (a, actions) => {
      const meta = [a.gender === 'MALE' ? '남' : a.gender === 'FEMALE' ? '여' : null, a.age ? `${a.age}세` : null, a.region].filter(Boolean).join(' · ');
      return `<div class="person">
        <div>
          <strong>${esc(a.nickname || '이름 없음')}${a.jobVerified ? '<em class="seal">직장 인증</em>' : ''}</strong>
          <span class="meta">${esc(meta)}</span>
        </div>
        <div class="row">${actions}</div>
      </div>`;
    };

    $('detail').innerHTML = `
      <div class="stat-row">
        <div class="stat"><b>${confirmed.length}</b><span>확정</span></div>
        <div class="stat"><b>${waiting.length}</b><span>기다리는 중</span></div>
        <div class="stat"><b>${m.capacity - confirmed.length}</b><span>남은 자리</span></div>
      </div>

      <a class="kakao" href="${esc(m.kakaoLink)}" target="_blank" rel="noopener">오픈채팅 열기</a>
      <p class="hint">참가비 안내와 입금 확인은 오픈채팅에서 하세요. 확인이 끝나면 아래에서 ‘확정’을 눌러주세요.</p>

      ${waiting.length ? `<h3>기다리는 신청 ${waiting.length}</h3>
        ${waiting.map((a) => person(a, `
          <button class="btn small" data-confirm="${a.applicationId}">확정</button>
          <button class="btn ghost small" data-decline="${a.applicationId}">거절</button>`)).join('')}` : ''}

      ${confirmed.length ? `<h3>확정된 분 ${confirmed.length}</h3>
        ${confirmed.map((a) => person(a, '<span class="done">확정됨</span>')).join('')}` : ''}

      ${declined.length ? `<h3 class="quiet">거절 ${declined.length}</h3>
        ${declined.map((a) => person(a, '<span class="hint">거절함</span>')).join('')}` : ''}

      ${apps.length === 0 ? `<div class="blank"><strong>아직 신청한 분이 없어요.</strong><span>초대장 링크를 나눠보세요.</span></div>` : ''}

      <div class="share">
        <span class="hint">초대장 링크</span>
        <div class="row">
          <input readonly value="${SITE_URL}/m/${m.meetupId}" id="shareUrl" />
          <button class="btn ghost small" id="copyBtn">복사</button>
        </div>
      </div>

      <div class="row wrap gap">
        ${m.status === 'OPEN' ? `<button class="btn ghost small" data-hosting="close">모집 마감</button>` : ''}
        ${m.status === 'CLOSED' ? `<button class="btn ghost small" data-hosting="reopen">모집 다시 열기</button>` : ''}
        ${m.status !== 'DONE' && m.status !== 'CANCELED' ? `<button class="btn ghost small" data-hosting="complete">개최 완료</button>` : ''}
        ${m.status !== 'CANCELED' ? `<button class="btn ghost small danger" data-hosting="cancel">모임 취소</button>` : ''}
      </div>`;

    for (const b of $('detail').querySelectorAll('[data-confirm]')) b.onclick = () => act(b.dataset.confirm, 'confirm');
    for (const b of $('detail').querySelectorAll('[data-decline]')) b.onclick = () => act(b.dataset.decline, 'decline');
    for (const b of $('detail').querySelectorAll('[data-hosting]')) b.onclick = () => hosting(b.dataset.hosting);
    const copy = $('copyBtn');
    if (copy) copy.onclick = () => {
      $('shareUrl').select();
      navigator.clipboard?.writeText($('shareUrl').value);
      say('링크를 복사했어요.');
    };
  }

  async function act(applicationId, what) {
    if (what === 'decline' && !confirm('이 신청을 거절할까요?')) return;
    try {
      await api(`/meetups/applications/${applicationId}/${what}`, { method: 'POST' });
      const id = current.meetupId;
      await loadList();
      openDetail(id);
      say(what === 'confirm' ? '확정했어요. 오픈채팅에서도 알려주세요.' : '거절했어요.');
    } catch (e) { say(e.message, true); }
  }

  const HOSTING_ASK = { close: '모집을 마감할까요?', reopen: '모집을 다시 열까요?', complete: '개최를 완료로 표시할까요?', cancel: '모임을 취소할까요? 신청한 분들에게 알림이 갑니다.' };
  async function hosting(what) {
    if (!confirm(HOSTING_ASK[what])) return;
    try {
      await api(`/meetups/${current.meetupId}/hosting/${what}`, { method: 'POST' });
      const id = current.meetupId;
      await loadList();
      const still = meetups.find((m) => m.meetupId === id);
      if (still) openDetail(id); else view('list');
      say('바꿨어요.');
    } catch (e) { say(e.message, true); }
  }

  // ── 미리보기 ────────────────────────────────────────────
  for (const t of $('previewTabs').querySelectorAll('.tab')) {
    t.onclick = () => {
      previewView = t.dataset.view;
      for (const o of $('previewTabs').querySelectorAll('.tab')) o.classList.toggle('on', o === t);
      preview(current, true);
    };
  }

  /** 폼으로 만든 가짜 모임 — 아직 저장 전이라 서버에 물어볼 수 없다. */
  function draftFromForm() {
    const date = $('f-date').value, time = $('f-time').value;
    return {
      meetupId: null,
      title: $('f-title').value.trim() || '모임 이름',
      description: $('f-desc').value.trim(),
      meetAt: date && time ? `${date}T${time}:00+09:00` : new Date().toISOString(),
      place: $('f-place').value.trim() || '장소',
      capacity: Number($('f-capacity').value) || 8,
      fee: Number($('f-fee').value) || 0,
      feeFemale: $('f-feeFemale').value === '' ? null : Number($('f-feeFemale').value),
      coverUrls: covers,
      confirmedCount: 0,
      status: 'OPEN',
      requireJobVerified: $('f-jobVerified').checked,
    };
  }

  function preview(m, keepTab) {
    $('previewTabs').hidden = !m;
    if (!m) return;
    const d = new Date(m.meetAt);
    const feeLabel = m.feeFemale != null && m.feeFemale !== m.fee
      ? `남 ${won(m.fee)}원 · 여 ${m.feeFemale > 0 ? `${won(m.feeFemale)}원` : '무료'}`
      : m.fee > 0 ? `참가비 ${won(m.fee)}원` : '참가비 없음';
    const left = Math.max(0, (m.capacity || 0) - (m.confirmedCount || 0));

    if (previewView === 'card') {
      $('previewLabel').textContent = '앱 · 모임 탭';
      $('phoneNote').textContent = '회원이 모임 탭에서 이 카드로 만나요. 첫 장이 카드의 얼굴이에요.';
      $('screen').innerHTML = `
        <div class="app-head"><b>모임</b><span>가까운 날짜의 모임부터 보여드려요</span></div>
        <div class="app-card">
          ${m.coverUrls?.[0] ? `<img src="${esc(m.coverUrls[0])}" alt="" />` : '<div class="app-cover-blank">커버 사진이 없어요</div>'}
          <div class="app-card-body">
            <div class="app-title">${esc(m.title)}</div>
            <div class="app-meta">${numeral(d)} (${'일월화수목금토'[d.getDay()]}) ${tf(d)}</div>
            <div class="app-meta">${esc(m.place)}</div>
            <div class="app-tags">
              <em>${feeLabel}</em><em>남은 자리 ${left}</em>${m.requireJobVerified ? '<em class="hot">직장 인증</em>' : ''}
            </div>
          </div>
        </div>`;
      return;
    }

    $('previewLabel').textContent = '앱 · 모임 상세 (초대장)';
    if (m.meetupId) {
      // 이미 연 모임은 서버가 그리는 진짜 초대장을 그대로 끼운다 — 흉내가 아니라 그 페이지다.
      $('phoneNote').textContent = '링크를 받은 사람이 보는 바로 그 초대장이에요.';
      $('screen').innerHTML = `<iframe src="${SITE_URL}/m/${m.meetupId}" title="초대장 미리보기"></iframe>`;
      return;
    }
    $('phoneNote').textContent = '아직 만들기 전이라 폼의 값으로 그려본 모습이에요.';
    $('screen').innerHTML = `
      <div class="inv">
        ${m.coverUrls?.[0] ? `<img class="inv-cover" src="${esc(m.coverUrls[0])}" alt="" />` : '<div class="app-cover-blank tall">커버 사진이 없어요</div>'}
        <div class="inv-body">
          <div class="inv-title">${esc(m.title)}</div>
          <div class="inv-date">${numeral(d)}</div>
          <div class="inv-meta">${'일월화수목금토'[d.getDay()]}요일 ${tf(d)}</div>
          <div class="inv-dday">${dday(d)}</div>
          ${m.description ? `<p class="inv-desc">${esc(m.description)}</p>` : ''}
          <div class="inv-row"><span>장소</span><b>${esc(m.place)}</b></div>
          <div class="inv-row"><span>참가비</span><b>${feeLabel}</b></div>
          <div class="inv-row"><span>남은 자리</span><b>${left}</b></div>
        </div>
      </div>`;
  }

  // ── 개설 ────────────────────────────────────────────────
  $('newBtn').onclick = () => {
    covers = [];
    $('coverPreview').innerHTML = '';
    $('paneTitle').textContent = '새 모임';
    $('paneLead').textContent = '적는 대로 오른쪽 폰 화면이 따라 바뀌어요.';
    view('new');
    previewView = 'card';
    for (const o of $('previewTabs').querySelectorAll('.tab')) o.classList.toggle('on', o.dataset.view === 'card');
    preview(draftFromForm());
    say('');
  };
  $('backFromNew').onclick = () => loadList();
  $('backFromDetail').onclick = () => loadList();

  // 적는 동안 오른쪽이 따라 바뀐다 — 다 만들고 나서 "잘렸네"를 알면 늦다.
  for (const id of ['f-title', 'f-desc', 'f-date', 'f-time', 'f-place', 'f-capacity', 'f-fee', 'f-feeFemale', 'f-jobVerified']) {
    $(id).addEventListener('input', () => { if (!$('v-new').hidden) preview(draftFromForm(), true); });
  }

  $('f-cover').onchange = async (e) => {
    const files = [...e.target.files];
    if (!files.length) return;
    say('사진을 올리는 중…');
    try {
      for (const file of files) {
        const fd = new FormData();
        fd.append('file', file);
        const r = await api('/meetups/cover', { method: 'POST', body: fd, raw: true });
        covers.push(r.url);
      }
      $('coverPreview').innerHTML = covers.map((u) => `<img src="${esc(u)}" alt="" />`).join('');
      say(`사진 ${covers.length}장을 올렸어요.`);
      preview(draftFromForm(), true);
    } catch (err) { say(err.message, true); }
    e.target.value = '';
  };

  $('createBtn').onclick = async () => {
    const d = draftFromForm();
    if (!$('f-title').value.trim() || !$('f-date').value || !$('f-time').value || !$('f-place').value.trim() || !$('f-kakao').value.trim()) {
      return say('별표 친 칸을 채워주세요', true);
    }
    try {
      say('여는 중…');
      await api('/meetups', {
        method: 'POST',
        body: {
          title: d.title,
          description: d.description || null,
          meetAt: d.meetAt,
          place: d.place,
          placeAddress: $('f-address').value.trim() || null,
          capacity: d.capacity,
          fee: d.fee,
          feeFemale: d.feeFemale,
          requireJobVerified: d.requireJobVerified,
          coverUrls: covers,
          kakaoLink: $('f-kakao').value.trim(),
        },
      });
      for (const id of ['f-title', 'f-desc', 'f-address', 'f-place', 'f-kakao']) $(id).value = '';
      covers = [];
      $('coverPreview').innerHTML = '';
      await loadList();
      say('모임을 열었어요. 초대장 링크를 나눠보세요.');
    } catch (e) { say(e.message, true); }
  };

  if (token) {
    $('gate').hidden = true;
    $('app').hidden = false;
    loadList().catch(() => logout());
  }
</script>

<style is:global>
  /*
   * 전역으로 둔다. 이 화면은 목록·신청자·미리보기를 전부 JS로 그리는데,
   * Astro의 스코프 스타일은 빌드 때 있는 요소에만 붙어서 나중에 그린 마크업은 맨몸이 된다.
   * 대신 모든 선택자를 .console 아래로 묶어 바깥으로 새지 않게 한다.
   */

  .console { padding: 40px 0 80px; }
  .console .wide { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

  /* 로그인 */
  .console .gate { display: flex; justify-content: center; padding: 40px 0; }
  .console .gate[hidden] { display: none; }
  .console .gate-card { width: min(440px, 100%); display: grid; gap: 14px; padding: 32px; background: var(--paper); border: 1px solid var(--border); border-radius: 20px; }
  .console .gate-card h1 { font-size: 1.6rem; }

  /* 2분할 */
  .console .split { display: grid; grid-template-columns: minmax(0, 1fr) 430px; gap: 32px; align-items: start; }
  .console .split[hidden] { display: none; }
  .console .pane { min-width: 0; }
  .console .pane-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .console .pane-head h1 { font-size: 1.5rem; }
  .console .head-actions { display: flex; gap: 8px; flex-shrink: 0; }
  .console .lead { color: var(--muted); margin-top: 6px; font-size: 0.95rem; }
  .console .back { background: none; border: 0; color: var(--muted); font: inherit; cursor: pointer; padding: 0 0 16px; }

  /* 목록 카드 */
  .console .card { display: flex; gap: 14px; width: 100%; text-align: left; padding: 14px; margin-bottom: 12px; background: var(--paper); border: 1px solid var(--border); border-radius: 16px; cursor: pointer; font: inherit; }
  .console .card:hover { border-color: var(--terracotta-soft); }
  .console .thumb { width: 104px; height: 72px; object-fit: cover; border-radius: 10px; flex-shrink: 0; }
  .console .blank-thumb { background: var(--surface); }
  .console .card-body { display: grid; gap: 6px; min-width: 0; }
  .console .card-body strong { font-size: 1.05rem; }
  .console .meta { color: var(--muted); font-size: 0.9rem; }
  .console .tags, .console .app-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .console .tag, .console .app-tags em { font-style: normal; font-size: 0.78rem; padding: 3px 9px; border-radius: 999px; background: var(--surface); color: var(--muted); }
  .console .tag.on { background: var(--terracotta); color: #fff; }
  .console .tag.warn { background: var(--terracotta-strong); color: #fff; }

  /* 상세 */
  .console .stat-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 18px; }
  .console .stat { padding: 16px; background: var(--paper); border-radius: 14px; text-align: center; }
  .console .stat b { display: block; font-size: 1.5rem; color: var(--terracotta-strong); }
  .console .stat span { color: var(--muted); font-size: 0.85rem; }
  .console .kakao { display: block; text-align: center; padding: 14px; border-radius: 999px; background: #fee500; color: #191600; font-weight: 700; }
  .console h3 { margin: 24px 0 8px; font-size: 1rem; }
  .console h3.quiet { color: var(--muted); }
  .console .person { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 0; border-top: 1px solid var(--border); }
  .console .person strong { display: block; }
  .console .seal { font-style: normal; margin-left: 7px; padding: 2px 8px; border-radius: 999px; background: var(--terracotta); color: #fff; font-size: 0.72rem; }
  .console .done { color: var(--terracotta-strong); font-weight: 700; font-size: 0.9rem; }
  .console .share { margin-top: 26px; display: grid; gap: 8px; }
  .console .share input { font-size: 0.85rem; }
  .console .row { display: flex; gap: 8px; align-items: center; }
  .console .row.wrap { flex-wrap: wrap; }
  .console .row.gap { margin-top: 22px; }
  .console .blank { padding: 34px 18px; text-align: center; background: var(--paper); border-radius: 16px; display: grid; gap: 6px; }
  .console .blank span { color: var(--muted); font-size: 0.9rem; }

  /* 폼 */
  .console .form { display: grid; gap: 16px; }
  .console .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .console .field { display: grid; gap: 6px; font-size: 0.93rem; }
  .console .field span { font-weight: 600; }
  .console .field em { font-style: normal; font-weight: 400; color: var(--muted); font-size: 0.84rem; }
  .console .field[hidden] { display: none; }
  .console input, .console textarea { width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; font: inherit; background: var(--surface); color: inherit; }
  .console .check { display: flex; align-items: center; gap: 8px; font-size: 0.93rem; }
  .console .check input { width: auto; }
  .console .covers { display: flex; flex-wrap: wrap; gap: 8px; }
  .console .covers img { width: 92px; height: 52px; object-fit: cover; border-radius: 8px; }

  .console .btn { padding: 13px 22px; border: 0; border-radius: 999px; background: var(--ink); color: var(--paper); font: inherit; font-weight: 700; cursor: pointer; }
  .console .btn.block { width: 100%; }
  .console .btn.small { padding: 9px 15px; font-size: 0.88rem; }
  .console .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--border); }
  .console .btn.danger { color: var(--terracotta-strong); }
  .console .hint { color: var(--muted); font-size: 0.88rem; }
  .console .msg { margin-top: 18px; font-weight: 600; }
  .console .msg[hidden] { display: none; }
  .console .msg.bad { color: var(--terracotta-strong); }

  /* 폰 미리보기 — 오른쪽이 곧 참여자의 눈이다. */
  .console .pane.right { position: sticky; top: 84px; }
  .console .preview-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .console .preview-head span { color: var(--muted); font-size: 0.88rem; font-weight: 600; }
  .console .tabs { display: flex; gap: 4px; }
  .console .tabs[hidden] { display: none; }
  .console .tab { padding: 6px 12px; border: 0; border-radius: 999px; background: var(--surface); color: var(--muted); font: inherit; font-size: 0.82rem; cursor: pointer; }
  .console .tab.on { background: var(--ink); color: var(--paper); }
  .console .phone { width: 390px; max-width: 100%; height: 720px; padding: 12px; background: #1b2126; border-radius: 44px; box-shadow: 0 18px 50px rgba(27, 33, 38, 0.18); }
  .console .screen { width: 100%; height: 100%; background: var(--paper); border-radius: 33px; overflow: auto; }
  .console .screen iframe { width: 100%; height: 100%; border: 0; }
  .console .empty-preview { padding: 60px 30px; text-align: center; color: var(--muted); font-size: 0.9rem; line-height: 1.7; }
  .console .phone-note { margin-top: 12px; color: var(--muted); font-size: 0.85rem; }

  /* 폰 안의 앱 흉내 — 실물과 완전히 같지는 않지만 조판과 잘림은 그대로 보인다. */
  .console .app-head { padding: 22px 20px 14px; display: grid; gap: 5px; }
  .console .app-head b { font-size: 1.5rem; }
  .console .app-head span { color: var(--muted); font-size: 0.85rem; }
  .console .app-card { margin: 0 16px; background: var(--surface); border-radius: 18px; overflow: hidden; }
  .console .app-card img { width: 100%; height: 176px; object-fit: cover; display: block; }
  .console .app-cover-blank { height: 176px; display: grid; place-items: center; background: var(--paper); color: var(--muted); font-size: 0.85rem; }
  .console .app-cover-blank.tall { height: 260px; }
  .console .app-card-body { padding: 16px; display: grid; gap: 7px; }
  .console .app-title { font-size: 1.05rem; font-weight: 700; }
  .console .app-meta { color: var(--muted); font-size: 0.87rem; }
  .console .app-tags { margin-top: 4px; }
  .console .app-tags em.hot { background: var(--terracotta); color: #fff; }
  .console .inv-cover { width: 100%; height: 260px; object-fit: cover; display: block; }
  .console .inv-body { padding: 26px 24px; text-align: center; display: grid; gap: 8px; }
  .console .inv-title { font-family: var(--serif); font-size: 1.5rem; font-weight: 700; }
  .console .inv-date { font-size: 1.15rem; letter-spacing: 1px; }
  .console .inv-meta, .console .inv-dday { color: var(--muted); font-size: 0.88rem; }
  .console .inv-desc { margin-top: 12px; font-size: 0.92rem; line-height: 1.75; white-space: pre-wrap; }
  .console .inv-row { display: flex; justify-content: space-between; padding: 11px 0; border-top: 1px solid var(--border); font-size: 0.9rem; }
  .console .inv-row span { color: var(--muted); }

  @media (max-width: 1100px) {
    .console .split { grid-template-columns: 1fr; }
    .console .pane.right { position: static; }
    .console .phone { margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .console .grid2 { grid-template-columns: 1fr; }
    .console .wide { padding: 0 16px; }
  }
</style>
