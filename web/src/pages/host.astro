---
import Base from '../layouts/Base.astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../lib/site';
// 기존 /host 링크는 유지하되 작성·관리는 앱 한 곳에서만 한다.
---

<Base title="모임 만들기 — 프롤로그" description="모임 만들기와 참가자 관리는 프롤로그 앱에서 함께하세요." noindex>
  <section class="host-entry">
    <h1>모임 만들기는<br />앱 안으로 옮겼어요.</h1>
    <p>이름, 날짜, 장소, 정원만 정하면 돼요.<br />신청 확인부터 참가자 확정까지 한곳에서 관리해요.</p>
    <a class="btn" href="prologue:///meetup-host">앱에서 내 모임 열기</a>
    <p class="hint">앱이 열리지 않으면 최신 버전으로 업데이트해주세요.<br />기존 모임과 신청 기록은 그대로 남아 있어요.</p>
    <div class="downloads"><a href={APP_STORE_URL}>App Store</a><a href={PLAY_STORE_URL}>Google Play</a></div>
  </section>
</Base>

<style>
  .host-entry { max-width: 560px; margin: 0 auto; padding: 100px 24px; text-align: center; }
  h1 { font-size: clamp(28px, 5vw, 40px); line-height: 1.4; }
  p { margin: 24px 0; color: var(--muted); line-height: 1.8; }
  .hint { font-size: 14px; }
  .downloads { display: flex; justify-content: center; gap: 24px; }
  .downloads a { color: var(--ink); }
</style>
