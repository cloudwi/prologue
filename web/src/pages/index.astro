---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { APP_STORE_URL, PLAY_STORE_URL, SITE_NAME, TAGLINE } from '../lib/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

// 이용 방법 — 앱 스토어 스크린샷과 같은 화면을 같은 순서로 보여준다(store/ 폴더의 결과물).
const steps = [
  {
    n: '01',
    title: '오늘의 질문에 답을 남겨요',
    body: '매일 하나의 질문이 도착해요. 짧아도 좋으니 오늘의 마음을 적어보세요. 답을 남겨야 상대의 답도 열립니다.',
    img: '/screens/4-answers.webp',
    alt: '프롤로그 앱 화면 — 내가 남긴 답변이 날짜별로 쌓인 목록',
  },
  {
    n: '02',
    title: '매일 정오, 오늘의 상대가 도착해요',
    body: '질문에 답한 사람 중 한 명이 소개돼요. 카드를 끝없이 넘기는 대신 오늘 한 사람의 답을 천천히 읽습니다.',
    img: '/screens/1-discover.webp',
    alt: '프롤로그 앱 화면 — 오늘의 질문과 나의 답, 그리고 오늘의 상대',
  },
  {
    n: '03',
    title: '마음이 닿으면 편지 한 통',
    body: '답이 마음에 들면 호감을 보내고, 이어가고 싶다면 300자 편지에 전화번호나 카카오톡 ID를 담아 건네요. 앱 안에 채팅은 없어요.',
    img: '/screens/3-letter.webp',
    alt: '프롤로그 앱 화면 — 연락처를 담아 보내는 편지 쓰기',
  },
  {
    n: '04',
    title: '편지는 봉투로 도착해요',
    body: '열어볼지, 조용히 거절할지는 받는 사람의 선택. 답장으로 서로의 연락처가 열리면 다음 이야기는 앱 밖에서 이어집니다.',
    img: '/screens/2-mails.webp',
    alt: '프롤로그 앱 화면 — 봉투로 도착한 편지와 열어보기·거절 버튼',
  },
];

const faqs = [
  {
    q: '프롤로그는 무료인가요?',
    a: '가입, 매일의 문답, 오늘의 상대 보기, 호감 보내기는 모두 무료예요. 연락처를 건네는 편지에만 "잉크"가 들어요. 처음 지갑을 열면 편지 한 통어치(50잉크)를 드리고, 매일 답을 남길 때마다 2잉크가 쌓이고, 친구를 초대하면 둘 다 100잉크를 받아서 돈을 내지 않아도 꾸준히 쓸 수 있어요. 잉크가 더 필요하면 앱 안에서 충전할 수 있습니다.',
  },
  {
    q: '왜 앱 안에 채팅이 없나요?',
    a: '시작되자마자 끊기는 대화보다, 신중한 한 통이 더 멀리 간다고 믿어요. 편지에 연락처를 담아 건네고, 상대가 답장으로 자기 연락처를 건네면 그때부터 두 사람의 이야기는 전화나 카카오톡으로 이어집니다. 읽지 않은 편지는 회수할 수 있어요.',
  },
  {
    q: '하루에 몇 명을 소개받나요?',
    a: '매일 정오, 오늘의 상대 한 사람이 도착해요. 최근에 질문에 답한 사람 가운데 답변의 결이 맞는 사람을 골라 소개하고, 한 번 만난 사람은 다시 소개하지 않아요.',
  },
  {
    q: '프로필은 어떻게 만드나요?',
    a: '자기소개는 한 문단이면 충분해요 — 상대가 프로필을 열면 "안녕하세요," 다음에 가장 먼저 읽는 인사말이에요. 그 아래로는 매일 질문에 남긴 답 중 마음에 드는 것을 프로필에 올리면, 그 답들이 나를 소개하는 한 통의 편지가 됩니다. 사진은 그 사이사이에 놓여요.',
  },
  {
    q: '안전하게 쓸 수 있나요?',
    a: '연락처 없이 앱 안에서만 서로를 알아가다가, 내가 원할 때만 연락처를 건네요. 지인 차단, 신고, 상대 차단 기능이 있고, 신고된 계정은 운영팀이 확인합니다. 편지는 받는 사람이 열어보기 전까지 내용이 공개되지 않아요.',
  },
  {
    q: '어떤 기기에서 쓸 수 있나요?',
    a: 'iPhone(App Store)과 Android(Google Play)에서 모두 쓸 수 있어요. 가입에는 이메일과 전화번호 인증이 필요합니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: `${SITE_NAME} - 하루 한 문답 소개팅`,
    alternateName: 'Prologue',
    slogan: TAGLINE,
    description:
      '새로운 시작을 알리는 하루 한 문답 소개팅 앱. 매일 정오 질문에 답한 사람이 도착하고, 마음이 닿으면 연락처를 담은 편지 한 통으로 이어집니다.',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'LifestyleApplication',
    inLanguage: 'ko',
    url: Astro.site?.toString(),
    installUrl: [APP_STORE_URL, PLAY_STORE_URL],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    author: { '@type': 'Organization', name: SITE_NAME },
    screenshot: steps.map((s) => new URL(s.img, Astro.site).toString()),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <section class="hero hero-split">
    <div class="container hero-grid">
      <div class="hero-copy">
        <img src="/brand-mark.png" alt="" class="brand-mark" width="106" height="76" />
        <p class="hero-en">PROLOGUE</p>
        <h1>
          새로운 시작을 알리는,<br />
          하루 한 문답 소개팅
        </h1>
        <p class="sub">
          모든 이야기의 시작에는 프롤로그가 있습니다.<br class="br-wide" />
          매일 정오, 질문에 답한 사람이 도착해요. 사진보다 생각이 먼저 닿는 인연.
        </p>
        <div class="actions" id="download">
          <StoreBadges />
        </div>
        <p class="hero-note">iPhone · Android 무료 다운로드 · 편지에만 잉크가 들어요</p>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="phone">
          <img src="/screens/1-discover.webp" alt="" width="330" height="717" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-label">프롤로그의 방식</div>
      <h2>하루 한 질문으로, 서로의 이야기를 읽어가요</h2>
      <p class="desc">
        조건만 스치듯 훑는 만남 대신, 매일 하나의 질문에 답하며 서로의 생각을 천천히
        들여다봅니다.
      </p>
      <div class="feature-grid">
        <div class="feature-card">
          <img src="/avatars/1.png" alt="" width="96" height="96" />
          <h3>하루 한 문답</h3>
          <p>매일 도착하는 하나의 질문. 서두르지 않고, 하루에 한 걸음씩 서로를 알아가요.</p>
        </div>
        <div class="feature-card">
          <img src="/avatars/2.png" alt="" width="96" height="96" />
          <h3>편지 같은 프로필</h3>
          <p>인사 한 문단, 그 아래 질문에 남긴 답이 쌓여 나를 소개해요. 프로필은 청첩장처럼 한 통의 편지로 펼쳐집니다.</p>
        </div>
        <div class="feature-card">
          <img src="/avatars/3.png" alt="" width="96" height="96" />
          <h3>매일 정오, 오늘의 상대</h3>
          <p>수백 장의 카드를 넘기는 대신 매일 정오 한 사람이 도착해요. 마음이 닿으면 연락처를 담은 편지 한 통으로 이어집니다.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="container">
      <div class="section-label">이용 방법</div>
      <h2>프롤로그는 이렇게 만나요</h2>
      <p class="desc">가입부터 첫 편지까지, 앱 화면 그대로 보여드릴게요.</p>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <div class="step-shot">
                <img src={s.img} alt={s.alt} width="300" height="652" loading="lazy" />
              </div>
              <div class="step-text">
                <span class="step-n">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="quote">
    <div class="mark">“</div>
    <p>
      모든 이야기의 시작에는 프롤로그가 있습니다.<br />
      당신의 다음 이야기가 여기에서 시작되기를.
    </p>
  </section>

  <section class="section alt" id="faq">
    <div class="container narrow">
      <div class="section-label">자주 묻는 질문</div>
      <h2>궁금한 점이 있으신가요?</h2>
      <div class="faq-list">
        {
          faqs.map((f, i) => (
            <details class="faq" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container">
      <h2>당신의 새로운 시작, 오늘의 질문부터</h2>
      <p class="desc">지금 다운로드하고, 정오에 도착할 오늘의 상대를 만나보세요. 모든 이야기의 시작에는 프롤로그가 있으니까요.</p>
      <div class="actions">
        <StoreBadges />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label">스토리</div>
      <h2>프롤로그가 쓰는 이야기</h2>
      <div class="post-list">
        {
          posts.map((post) => (
            <a class="post-card" href={`/story/${post.id}`}>
              <div class="meta">{dateFmt.format(post.data.pubDate)}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))
        }
      </div>
      <p style="margin-top: 28px;"><a href="/story" style="color: var(--terracotta-strong); font-weight: 600;">스토리 전체 보기 →</a></p>
    </div>
  </section>
</Base>
