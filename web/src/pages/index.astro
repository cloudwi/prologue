---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Icon from '../components/Icon.astro';
import ProfilePreview from '../components/ProfilePreview.astro';
import { APP_STORE_URL, PLAY_STORE_URL, SITE_NAME, TAGLINE } from '../lib/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

// 이용 방법 — 앱 스토어 스크린샷과 같은 화면을 같은 순서로 보여준다(store/ 폴더의 결과물).
const steps = [
  {
    n: '01',
    title: '오늘의 질문에 답을 남겨요',
    body: '매일 하나의 질문이 도착해요. 길게 쓰지 않아도 좋아요. 오늘의 생각을 남기며 나를 소개하는 이야기를 쌓아가세요.',
    img: '/screens/4-answers.webp',
    alt: '프롤로그 앱 화면 — 내가 남긴 답변이 날짜별로 쌓인 목록',
  },
  {
    n: '02',
    title: '답을 남기면, 오늘의 상대가 도착해요',
    body: '답을 쓰는 순간 질문에 답한 한 사람이 소개돼요. 카드를 끝없이 넘기는 대신 오늘 한 사람의 답을 천천히 읽습니다.',
    img: '/screens/1-discover.webp',
    alt: '프롤로그 앱 화면 — 오늘의 질문과 나의 답, 그리고 오늘의 상대',
  },
  {
    n: '03',
    title: '마음이 닿으면 편지 한 통',
    body: '답이 마음에 들면 호감을 보내고, 이어가고 싶다면 300자 편지에 전화번호나 카카오톡 ID를 담아 건네요. 앱 안에 채팅은 없어요.',
    img: '/screens/3-letter.webp',
    alt: '프롤로그 앱 화면 — 연락처를 담아 보내는 편지 쓰기',
  },
  {
    n: '04',
    title: '편지는 봉투로 도착해요',
    body: '열어볼지, 조용히 거절할지는 받는 사람의 선택. 답장으로 서로의 연락처가 열리면 다음 이야기는 앱 밖에서 이어집니다.',
    img: '/screens/2-mails.webp',
    alt: '프롤로그 앱 화면 — 봉투로 도착한 편지와 열어보기·거절 버튼',
  },
  {
    n: '05',
    title: '문답 밖에서, 모임으로',
    body: '글로만 알아가는 게 답답할 땐 오프라인 모임에 신청해보세요. 모임 페이지는 초대장처럼 펼쳐지고, 같은 모임이 다시 열리면 알림을 받을 수 있어요.',
    img: '/screens/5-meetup.webp',
    alt: '프롤로그 앱 화면 — 초대장처럼 펼쳐지는 오프라인 모임 상세',
  },
];

const faqs = [
  {
    q: '프롤로그는 무료인가요?',
    a: '가입, 매일의 문답, 오늘의 상대 보기와 호감 보내기는 무료예요. 편지를 보내거나 닫힌 프로필·답변을 추가로 열람할 때는 잉크를 사용해요. 잉크는 문답 등 앱 활동으로 모으거나 앱 안에서 충전할 수 있고, 사용하기 전에 필요한 양을 확인할 수 있어요.',
  },
  {
    q: '왜 앱 안에 채팅이 없나요?',
    a: '시작되자마자 끊기는 대화보다, 신중한 한 통이 더 멀리 간다고 믿어요. 편지에 연락처를 담아 건네고, 상대가 답장으로 자기 연락처를 건네면 그때부터 두 사람의 이야기는 전화나 카카오톡으로 이어집니다. 읽지 않은 편지는 회수할 수 있어요.',
  },
  {
    q: '하루에 몇 명을 소개받나요?',
    a: '오늘의 질문에 답을 남기면 그 자리에서 한 사람이 도착해요. 최근에 질문에 답한 사람 가운데 답변의 결이 맞는 사람을 골라 소개하고, 한 번 만난 사람은 다시 소개하지 않아요.',
  },
  {
    q: '프로필은 어떻게 만드나요?',
    a: '자기소개는 한 문단이면 충분해요 — 상대가 프로필을 열면 "안녕하세요," 다음에 가장 먼저 읽는 인사말이에요. 그 아래로는 매일 질문에 남긴 답 중 마음에 드는 것을 프로필에 올리면, 그 답들이 나를 소개하는 한 통의 편지가 됩니다. 사진은 그 사이사이에 놓여요.',
  },
  {
    q: '안전하게 쓸 수 있나요?',
    a: '연락처 없이 앱 안에서만 서로를 알아가다가, 내가 원할 때만 연락처를 건네요. 지인 차단, 신고, 상대 차단 기능이 있고, 신고된 계정은 운영팀이 확인합니다. 편지는 받는 사람이 열어보기 전까지 내용이 공개되지 않아요.',
  },
  {
    q: '어떤 기기에서 쓸 수 있나요?',
    a: 'iPhone(App Store)과 Android(Google Play)에서 모두 쓸 수 있어요. 가입에는 이메일과 전화번호 인증이 필요합니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: `${SITE_NAME} - 하루 한 문답 소개팅`,
    alternateName: 'Prologue',
    slogan: TAGLINE,
    description:
      '새로운 시작을 알리는 하루 한 문답 소개팅 앱. 질문에 답을 남기면 그 자리에서 한 사람이 도착하고, 마음이 닿으면 연락처를 담은 편지 한 통으로 이어집니다.',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'LifestyleApplication',
    inLanguage: 'ko',
    url: Astro.site?.toString(),
    installUrl: [APP_STORE_URL, PLAY_STORE_URL],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    author: { '@type': 'Organization', name: SITE_NAME },
    screenshot: steps.slice(2).map((s) => new URL(s.img, Astro.site).toString()),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <div class="landing">
    <section class="landing-hero">
      <div class="container landing-hero-grid">
        <div class="landing-copy">
          <p class="eyebrow"><span class="point-dot" aria-hidden="true"></span> 하루 한 문답으로 시작하는 소개팅</p>
          <h1>사진보다 먼저,<br /><span>당신의 이야기를.</span></h1>
          <p class="landing-lead">오늘의 질문에 답하고, 한 사람의 생각을 만나세요.<br class="desktop-break" /> 마음이 닿으면 진심을 담은 편지 한 통으로.</p>
          <div class="landing-actions">
            <a class="btn btn-primary" href="/download">프롤로그 시작하기 <Icon name="arrow" size={18} /></a>
            <a class="btn btn-ghost" href="#how">어떻게 만나나요?</a>
          </div>
          <p class="landing-note">iPhone · Android에서 무료로 시작하세요</p>
          <div class="hero-principles">
            <span><Icon name="check" size={15} /> 하루 한 문답</span>
            <span><Icon name="check" size={15} /> 편지로 건네는 마음</span>
          </div>
        </div>
        <div class="landing-visual" aria-hidden="true">
          <div class="visual-heading"><span>한 사람을 알아가는, 우리의 속도</span><Icon name="heart" size={20} /></div>
          <div class="landing-phone"><ProfilePreview eager /></div>
          <div class="visual-note"><span class="visual-note-icon"><Icon name="mail" size={22} /></span><div><strong>생각이 먼저 닿는 인연</strong><span>다음 이야기는 편지로 이어가요.</span></div></div>
          <span class="visual-caption">PROLOGUE · A NEW BEGINNING</span>
        </div>
      </div>
    </section>

    <section class="landing-section" aria-labelledby="way-title">
      <div class="container">
        <div class="landing-section-head"><div><p class="eyebrow">프롤로그의 방식</p><h2 id="way-title">한 사람을,<br />조금 더 깊이 알아가는 일.</h2></div><p>매일의 작은 답변이 나를 소개하고,<br />서로에게 말을 건넬 이유가 됩니다.</p></div>
        <div class="principle-grid">
          <article class="principle-card"><span class="principle-icon"><Icon name="message" size={24} /></span><span class="principle-number">01</span><h3>대화의 시작은<br />좋은 질문 하나</h3><p>오늘의 질문에 짧은 답을 남겨요. 거창한 자기소개보다 평소의 생각이 더 잘 전해질 때가 있으니까요.</p></article>
          <article class="principle-card"><span class="principle-icon"><Icon name="lines" size={24} /></span><span class="principle-number">02</span><h3>내가 남긴 답이<br />나를 소개하도록</h3><p>마음에 드는 답과 사진을 모아 나만의 프로필을 만들어요. 한 통의 편지를 읽듯 서로를 알아가요.</p></article>
          <article class="principle-card principle-card--accent"><span class="principle-icon"><Icon name="mail" size={24} /></span><span class="principle-number">03</span><h3>마음이 닿았다면,<br />진심을 담은 한 통</h3><p>편지에 연락처를 담아 건네요. 상대가 답장하면 다음 이야기는 두 사람이 편한 곳에서 이어집니다.</p></article>
        </div>
      </div>
    </section>

    <section class="landing-section walkthrough-section" id="how" aria-labelledby="how-title">
      <div class="container">
        <div class="landing-section-head"><div><p class="eyebrow">앱 미리보기</p><h2 id="how-title">시작은 가볍게.<br />이야기는 자연스럽게.</h2></div><p>궁금한 단계를 눌러보세요.<br />실제 앱 화면으로 안내해 드릴게요.</p></div>
        <div class="walkthrough" data-walkthrough>
          <div class="walkthrough-nav" role="tablist" aria-label="프롤로그 이용 단계" hidden>
            {['문답 남기기', '오늘의 상대', '편지 쓰기', '편지함', '모임'].map((label, i) => <button type="button" role="tab" id={`step-tab-${i}`} aria-controls={`step-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><span>{steps[i].n}</span>{label}</button>)}
          </div>
          {steps.map((s, i) => <article class="walkthrough-panel" id={`step-panel-${i}`} role="tabpanel" aria-labelledby={`step-tab-${i}`} tabindex="0">
            <div class="walkthrough-copy"><span class="walkthrough-count">STEP {s.n} / 05</span><h3>{s.title}</h3><p>{s.body}</p><a class="text-link" href="/download">앱에서 시작하기 <Icon name="arrow" size={18} /></a></div>
            <div class="walkthrough-shot">{i < 2 ? <div class="walkthrough-profile"><ProfilePreview variant={i === 0 ? 'question' : 'peer'} /></div> : <img src={s.img} alt={s.alt} width="300" height="652" loading="lazy" />}</div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="landing-section" id="faq" aria-labelledby="faq-title">
      <div class="container faq-layout">
        <div class="faq-intro"><p class="eyebrow">자주 묻는 질문</p><h2 id="faq-title">시작하기 전,<br />궁금한 이야기.</h2><p>조금 더 알아보고 싶다면<br /><a class="text-link" href="/story/getting-started">처음 이용하는 분을 위한 안내 <Icon name="arrow" size={16} /></a></p></div>
        <div class="faq-list">{faqs.map((f) => <details class="faq" name="landing-faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </div>
    </section>

    <section class="landing-section landing-stories">
      <div class="container">
        <div class="landing-section-head"><div><p class="eyebrow">프롤로그 스토리</p><h2>우리가 생각하는 만남.</h2></div><a class="text-link" href="/story">모든 이야기 <Icon name="arrow" size={18} /></a></div>
        <div class="story-grid">{posts.map((post, i) => <a class="story-tile" href={`/story/${post.id}`}><div class:list={['story-art', `story-art--${i}`]} aria-hidden="true"><Icon name={['mail', 'message', 'heart'][i]} size={44} /></div><div class="story-tile-body"><span class="story-date">{dateFmt.format(post.data.pubDate)}</span><h3>{post.data.title}</h3><span class="story-read">이야기 읽기 <Icon name="external" size={18} /></span></div></a>)}</div>
      </div>
    </section>

    <section class="landing-closing">
      <div class="container"><div class="closing-panel"><img src="/brand-mark.webp" alt="" width="58" height="42" /><p class="eyebrow">당신의 다음 이야기</p><h2>오늘의 질문부터<br />시작해 볼까요?</h2><p>모든 이야기의 시작에는 프롤로그가 있습니다.</p><StoreBadges /><span class="landing-note">가입과 매일의 문답은 무료예요.</span></div></div>
    </section>
  </div>
</Base>

<script>
  import { initWalkthrough } from '../lib/walkthrough.js';
  document.querySelectorAll('[data-walkthrough]').forEach(initWalkthrough);
</script>

<style>
  .landing { overflow: clip; }
  .eyebrow { display: flex; align-items: center; gap: 8px; color: var(--terracotta-strong); font-size: 13px; font-weight: 650; letter-spacing: -.015em; }
  .point-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .landing-hero { padding: 64px 0 80px; }
  .landing-hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: center; }
  .landing-copy h1 { margin-top: 24px; font-size: clamp(40px, 4.6vw, 60px); line-height: 1.18; font-weight: 750; letter-spacing: -.065em; }
  .landing-copy h1 span { color: var(--terracotta-strong); }
  .landing-lead { margin-top: 28px; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .landing-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .landing-note { display: block; margin-top: 16px; color: var(--muted); font-size: 12px; }
  .hero-principles { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border); color: var(--muted); font-size: 12px; }
  .hero-principles span { display: flex; align-items: center; gap: 6px; }
  .landing-visual { position: relative; height: 562px; overflow: hidden; border: 1px solid var(--border); border-radius: 32px; background: var(--warm-soft); }
  .visual-heading { display: flex; justify-content: space-between; align-items: center; padding: 26px; color: var(--terracotta-strong); font-size: 12px; }
  .landing-phone { position: absolute; top: 92px; left: 50%; width: 245px; transform: translateX(-50%) rotate(5deg); border: 7px solid var(--device); border-radius: 36px; overflow: hidden; box-shadow: 0 28px 50px -20px var(--shadow); }
  .visual-note { position: absolute; bottom: 58px; left: 22px; right: 22px; display: flex; align-items: center; gap: 14px; padding: 18px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-soft); }
  .visual-note-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: var(--warm); color: var(--terracotta-strong); }
  .visual-note strong { display: block; font-size: 14px; font-weight: 650; }
  .visual-note div > span { display: block; margin-top: 3px; color: var(--muted); font-size: 12px; }
  .visual-caption { position: absolute; bottom: 22px; left: 26px; color: var(--muted); font-size: 9px; letter-spacing: .16em; }
  .landing-section { padding: 80px 0; }
  .landing-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 36px; }
  .landing h2 { margin-top: 14px; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.3; letter-spacing: -.05em; }
  .landing-section-head > p { color: var(--muted); font-size: 14px; line-height: 1.8; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .principle-card { position: relative; padding: 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-card); }
  .principle-card--accent { background: var(--warm-soft); }
  .principle-icon { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid var(--border); border-radius: 14px; color: var(--terracotta-strong); background: var(--surface); }
  .principle-number { position: absolute; top: 34px; right: 28px; color: var(--muted); font-size: 11px; }
  .principle-card h3 { margin-top: 30px; font-size: 23px; line-height: 1.4; }
  .principle-card p { margin-top: 16px; color: var(--muted); font-size: 14px; line-height: 1.8; }
  .walkthrough-section { background: var(--surface); border-block: 1px solid var(--border); }
  .walkthrough [hidden] { display: none !important; }
  .walkthrough-nav { display: flex; gap: 8px; padding: 6px; margin-bottom: 20px; overflow-x: auto; border: 1px solid var(--border); border-radius: 15px; background: var(--paper); scrollbar-width: none; }
  .walkthrough-nav button { display: flex; align-items: center; justify-content: center; flex: 1 0 auto; gap: 9px; min-height: 44px; padding: 10px 16px; border: 1px solid transparent; border-radius: 10px; color: var(--muted); background: transparent; font-size: 13px; cursor: pointer; }
  .walkthrough-nav button span { font-size: 10px; opacity: .7; }
  .walkthrough-nav button[aria-selected="true"] { background: var(--surface); color: var(--ink); border-color: var(--border); box-shadow: 0 2px 4px rgba(0,0,0,.04); font-weight: 650; }
  .walkthrough-panel { display: grid; grid-template-columns: 1fr 1fr; min-height: 460px; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-panel); background: var(--paper); }
  .walkthrough-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 48px; }
  .walkthrough-count { font-size: 11px; letter-spacing: .13em; color: var(--terracotta-strong); }
  .walkthrough-copy h3 { margin-top: 22px; font-size: 30px; line-height: 1.35; }
  .walkthrough-copy p { margin-top: 18px; color: var(--muted); font-size: 15px; line-height: 1.85; }
  .walkthrough-copy .text-link { margin-top: 28px; }
  .walkthrough-shot { display: flex; justify-content: center; align-items: flex-start; height: 480px; padding: 36px 28px 0; overflow: hidden; background: var(--warm-soft); border-left: 1px solid var(--border); }
  .walkthrough-shot img { display: block; width: 245px; height: auto; border: 1px solid var(--border); border-radius: 28px; box-shadow: 0 18px 40px -24px var(--shadow); }
  .walkthrough-profile { width: 245px; flex-shrink: 0; border: 1px solid var(--border); border-radius: 28px; overflow: hidden; box-shadow: 0 18px 40px -24px var(--shadow); }
  .text-link { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-size: 13px; font-weight: 600; }
  .text-link:hover { color: var(--terracotta-strong); }
  .faq-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 72px; align-items: start; }
  .faq-intro > p:last-child { margin-top: 24px; color: var(--muted); font-size: 14px; line-height: 2; }
