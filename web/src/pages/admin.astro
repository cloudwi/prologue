---
import '../styles/global.css';

// 웹 어드민 — 우표 이벤트 검토. 정적 페이지지만 브라우저에서 백엔드 API를 직접 호출한다.
// ADMIN role 계정으로 로그인해야 목록이 열린다(서버가 ROLE_ADMIN을 강제).
const API_BASE = 'https://prologue-backend.onrender.com';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>프롤로그 어드민</title>
    <!-- 운영 도구 — 색인·리퍼러 전달을 막는다 -->
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap"
    />
  </head>
  <body class="admin-body">
    <main class="admin-wrap">
      <h1 class="admin-title">프롤로그 어드민</h1>

      <!-- 로그인 — 앱과 같은 이메일 인증코드 방식 -->
      <section id="login" class="admin-card" hidden>
        <h2 class="admin-sub">로그인</h2>
        <p class="admin-desc">어드민 권한이 있는 계정의 이메일로 인증해 주세요.</p>
        <div class="admin-field">
          <input id="email" type="email" placeholder="이메일" autocomplete="email" />
          <button type="button" class="admin-btn ghost" id="send-code">코드 받기</button>
        </div>
        <div class="admin-field" id="code-row" hidden>
          <input id="code" inputmode="numeric" maxlength="6" placeholder="6자리 코드" />
          <button type="button" class="admin-btn" id="verify">로그인</button>
        </div>
        <p class="admin-msg" id="login-msg"></p>
      </section>

      <!-- 검토 패널 -->
      <section id="panel" hidden>
        <div class="admin-panel-head">
          <h2 class="admin-sub">우표 이벤트 검토</h2>
          <div>
            <button type="button" class="admin-btn ghost small" id="refresh">새로고침</button>
            <button type="button" class="admin-btn ghost small" id="logout">로그아웃</button>
          </div>
        </div>
        <div id="list" class="admin-card admin-list"></div>
      </section>
    </main>

    <script is:inline define:vars={{ API_BASE }}>
      const $ = (id) => document.getElementById(id);
      const TOKEN_KEY = 'pl_admin_token';
      let token = localStorage.getItem(TOKEN_KEY) || '';

      async function api(path, options = {}) {
        const res = await fetch(API_BASE + path, {
          ...options,
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: 'Bearer ' + token } : {}),
          },
        });
        if (res.status === 401 || res.status === 403) {
          throw Object.assign(new Error('권한이 없거나 세션이 만료됐어요.'), { auth: true });
        }
        const data = await res.json().catch(() => null);
        if (!res.ok) throw new Error((data && data.message) || 'HTTP ' + res.status);
        return data;
      }

      function showLogin(msg) {
        token = '';
        localStorage.removeItem(TOKEN_KEY);
        $('panel').hidden = true;
        $('login').hidden = false;
        $('login-msg').textContent = msg || '';
      }

      async function showPanel() {
        $('login').hidden = true;
        $('panel').hidden = false;
        await load();
      }

      async function load() {
        const listEl = $('list');
        listEl.textContent = '불러오는 중...';
        try {
          const data = await api('/admin/stamp-events');
          render(data.submissions);
        } catch (e) {
          if (e.auth) return showLogin('어드민 권한이 있는 계정으로 로그인해 주세요.');
          listEl.textContent = e.message;
        }
      }

      // innerHTML 금지 — url·닉네임은 사용자 입력이라 전부 textContent로만 그린다.
      function render(items) {
        const listEl = $('list');
        listEl.textContent = '';
        if (!items.length) {
          listEl.textContent = '검토할 제출이 없어요.';
          return;
        }
        for (const item of items) {
          const row = document.createElement('div');
          row.className = 'admin-row';

          const info = document.createElement('div');
          info.className = 'admin-row-info';
          const name = document.createElement('div');
          name.className = 'admin-row-name';
          name.textContent = item.nickname || '(닉네임 없음)';
          const link = document.createElement('a');
          link.className = 'admin-row-url';
          link.href = item.url;
          link.textContent = item.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          const date = document.createElement('div');
          date.className = 'admin-row-date';
          date.textContent = new Date(item.createdAt).toLocaleString('ko-KR');
          info.append(name, link, date);

          const actions = document.createElement('div');
          actions.className = 'admin-row-actions';
          const amount = document.createElement('input');
          amount.className = 'admin-amount';
          amount.type = 'number';
          amount.min = '1';
          amount.value = '5';
          const approve = document.createElement('button');
          approve.className = 'admin-btn small';
          approve.textContent = '승인';
          approve.onclick = () => {
            const n = Number(amount.value);
            if (!Number.isInteger(n) || n < 1) return alert('지급할 우표 수를 확인해 주세요.');
            if (confirm('우표 ' + n + '장을 지급할까요?')) decide(item.id, 'approve', n, approve);
          };
          const reject = document.createElement('button');
          reject.className = 'admin-btn ghost small';
          reject.textContent = '반려';
          reject.onclick = () => {
            if (confirm('반려할까요? 지급 없이 닫혀요.')) decide(item.id, 'reject', null, reject);
          };
          actions.append(amount, approve, reject);

          row.append(info, actions);
          listEl.append(row);
        }
      }

      async function decide(id, action, amount, btn) {
        btn.disabled = true;
        try {
          await api('/admin/stamp-events/' + id + '/' + action, {
            method: 'POST',
            body: JSON.stringify(action === 'approve' ? { amount } : {}),
          });
          await load();
        } catch (e) {
          if (e.auth) return showLogin('세션이 만료됐어요. 다시 로그인해 주세요.');
          alert(e.message);
          btn.disabled = false;
        }
      }

      $('send-code').addEventListener('click', async () => {
        const email = $('email').value.trim();
        if (!email) return;
        $('send-code').disabled = true;
        try {
          await api('/auth/email/request-code', { method: 'POST', body: JSON.stringify({ email }) });
          $('code-row').hidden = false;
          $('login-msg').textContent = '메일로 6자리 코드를 보냈어요.';
          $('code').focus();
        } catch (e) {
          $('login-msg').textContent = e.message;
        } finally {
          $('send-code').disabled = false;
        }
      });

      $('verify').addEventListener('click', async () => {
        const email = $('email').value.trim();
        const code = $('code').value.trim();
        if (!email || !/^\d{6}$/.test(code)) {
          $('login-msg').textContent = '이메일과 6자리 코드를 확인해 주세요.';
          return;
        }
        $('verify').disabled = true;
        try {
          const data = await api('/auth/email/verify', { method: 'POST', body: JSON.stringify({ email, code }) });
          token = data.accessToken;
          localStorage.setItem(TOKEN_KEY, token);
          await showPanel();
        } catch (e) {
          $('login-msg').textContent = e.message;
        } finally {
          $('verify').disabled = false;
        }
      });

      $('refresh').addEventListener('click', load);
      $('logout').addEventListener('click', () => showLogin(''));

      if (token) showPanel();
      else showLogin('');
    </script>

    <style>
      .admin-body {
        min-height: 100vh;
        padding: 48px 20px;
      }
      .admin-wrap {
        max-width: 720px;
        margin: 0 auto;
      }
      .admin-title {
        font-size: 24px;
        margin-bottom: 24px;
      }
      .admin-sub {
        font-size: 17px;
      }
      .admin-desc {
        color: var(--muted);
        font-size: 14px;
        margin: 6px 0 16px;
      }
      .admin-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 22px;
      }
      .admin-field {
        display: flex;
        gap: 8px;
        margin-top: 10px;
      }
      .admin-field input {
        flex: 1;
        height: 44px;
        padding: 0 14px;
        font-size: 15px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--paper);
        color: var(--ink);
      }
      .admin-btn {
        height: 44px;
        padding: 0 18px;
        border: 0;
        border-radius: 10px;
        background: var(--terracotta);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
      }
      .admin-btn.ghost {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--terracotta-strong);
      }
      .admin-btn.small {
        height: 36px;
        padding: 0 14px;
        font-size: 13px;
      }
      .admin-btn:disabled {
        opacity: 0.5;
        cursor: default;
      }
      .admin-msg {
        color: var(--muted);
        font-size: 13px;
        margin-top: 12px;
        min-height: 1.2em;
      }
      .admin-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      .admin-list {
        padding: 6px 22px;
        color: var(--muted);
        font-size: 14px;
      }
      .admin-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 0;
      }
      .admin-row + .admin-row {
        border-top: 1px solid var(--border);
      }
      .admin-row-info {
        flex: 1;
        min-width: 0;
      }
      .admin-row-name {
        color: var(--ink);
        font-weight: 700;
        font-size: 15px;
      }
      .admin-row-url {
        display: block;
        color: var(--terracotta-strong);
        font-size: 13px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-decoration: underline;
      }
      .admin-row-date {
        color: var(--muted);
        font-size: 12px;
        margin-top: 2px;
      }
      .admin-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .admin-amount {
        width: 58px;
        height: 36px;
        text-align: center;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--paper);
        color: var(--ink);
        font-size: 14px;
      }
      @media (max-width: 560px) {
        .admin-row {
          flex-direction: column;
          align-items: stretch;
        }
        .admin-row-actions {
          justify-content: flex-end;
        }
      }
    </style>
  </body>
</html>
