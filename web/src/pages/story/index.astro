---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="스토리 — 프롤로그 팀이 쓰는 만남과 가치관 이야기" description="하루 한 문답 소개팅 앱 프롤로그의 사용법, 만남과 가치관에 대한 생각, 서비스를 만드는 뒷이야기를 기록합니다.">
  <section class="section">
    <div class="container">
      <div class="section-label">스토리</div>
      <h1 class="story-index-title">우리가 생각하는 만남.</h1>
      <p class="desc">만남과 가치관에 대한 생각들, 그리고 프롤로그를 만들어가는 뒷이야기를 기록합니다.</p>
      <div class="post-list">
        {
          posts.map((post) => (
            <a class="post-card" href={`/story/${post.id}`}>
              <div class="meta">{dateFmt.format(post.data.pubDate)}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .story-index-title { margin-top: 18px; font-size: clamp(32px, 4vw, 48px); }
  .post-card:first-child { grid-column: 1 / -1; padding: 36px; background: var(--warm-soft); }
  .post-card:first-child h3 { font-size: clamp(22px, 3vw, 30px); max-width: 680px; }
  .post-card .meta { font-size: 12px; }
  @media (max-width: 560px) { .post-card:first-child { padding: 24px; } }
</style>
