---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { SITE_NAME } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const pageUrl = new URL(`/story/${post.id}`, Astro.site).toString();

// 글 하나가 검색 결과에 "기사"로 잡히게 하는 구조화 데이터. 날짜·저자·게시자가 핵심.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: 'ko-KR',
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    image: new URL('/og.png', Astro.site).toString(),
    author: { '@type': 'Organization', name: `${SITE_NAME} 팀` },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      logo: { '@type': 'ImageObject', url: new URL('/brand-mark.png', Astro.site).toString() },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: '스토리', item: new URL('/story', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
    ],
  },
];
---

<Base title={`${post.data.title} — 프롤로그 스토리`} description={post.data.description} type="article" jsonLd={jsonLd}>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time> · 프롤로그 팀
    </div>
    <Content />

    <aside class="post-cta">
      <h3>하루 한 문답으로 만나는 소개팅, 프롤로그</h3>
      <p>매일 정오, 같은 질문에 답한 사람이 도착해요. iPhone·Android에서 무료로 시작할 수 있어요.</p>
      <StoreBadges />
    </aside>
  </article>
</Base>
