---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="성장 지표">
  <div class="growth-toolbar">
    <p>가입부터 답장까지, 실제로 이어진 경험을 확인하세요.</p>
    <label>조회 기간 <select id="growth-days"><option value="7">최근 7일</option><option value="30" selected>최근 30일</option><option value="90">최근 90일</option></select></label>
  </div>
  <p id="growth-since" class="growth-note"></p>
  <div id="growth-content" aria-live="polite"></div>
  <details class="growth-definitions">
    <summary>지표는 어떻게 계산하나요?</summary>
    <p>하루는 한국 시간 정오에 시작합니다. 가입·소개·편지 전환율은 조회 기간에 첫 행동을 한 이용자가 그 뒤 7일 안에 다음 행동을 했는지 계산합니다. 아직 7일이 지나지 않은 이용자는 분모에서 제외합니다. 같은 상대에게 한 행동인지를 따지는 비율은 아닙니다.</p>
    <p>답변 후 소개율은 종료된 하루를 기준으로, 답변을 새로 작성한 이용자·날짜 중 그날 상대 카드를 API로 제공받은 비율입니다. 화면을 실제로 읽었는지는 알 수 없습니다. 7일 재방문은 가입한 서비스 날짜의 정확히 7일 뒤 인증 요청이 있었는지를 보며, 해당 하루가 끝난 후 계산합니다.</p>
    <p>연락처 교환은 두 사람이 서로 편지를 보내 연락처를 제공한 상태입니다. 연락처 열람이나 실제 만남을 뜻하지 않습니다. 관리자·설정된 심사 계정은 수집에서 제외하며, 탈퇴하면 해당 계정 기록도 삭제됩니다.</p>
    <p>수집 시작 전의 행동을 추정해 채우지 않습니다. 아직 관찰 기간이 부족한 비율은 0% 대신 ‘집계 대기’로 표시합니다. 이탈 이유나 실제 만남 여부는 이 이벤트만으로 판단할 수 없습니다.</p>
  </details>
  <script is:inline>
    const names = {
      REGISTERED: '신규 가입', ONBOARDED: '프로필 작성 완료', ANSWER_SUBMITTED: '새 문답 작성',
      PEER_CHECKED: '소개 확인', PEER_AVAILABLE: '상대 카드 제공', HEART_SENT: '호감 보내기',
      MAIL_SENT: '편지 보내기', MAIL_REPLIED: '답장 보내기', MAIL_REPLY_RECEIVED: '답장 받기',
      CONTACTS_EXCHANGED: '상호 연락처 제공', ACTIVE_DAY: '활성 이용자·날짜',
    };
    const rateNames = {
      signup_to_answer: '가입 → 첫 문답', answer_to_peer: '답변한 날 → 상대 소개',
      peer_to_heart: '상대 소개 → 호감', peer_to_mail: '상대 소개 → 편지',
      mail_to_reply: '편지 보낸 이용자 → 답장 받기', d7_retention: '가입 7일 뒤 재방문',
    };
    const node = (tag, text, className) => {
      const el = document.createElement(tag); if (text != null) el.textContent = text;
      if (className) el.className = className; return el;
    };
    window.pageLoad = async function () {
      const { $, api, showLogin } = window.admin;
      const content = $('growth-content'), days = $('growth-days');
      if (content.getAttribute('aria-busy') === 'true') return;
      days.disabled = true;
      const done = window.admin.loading(content, { variant: 'stats', label: '성장 지표를 계산하고 있어요' });
      try {
        const report = await api('/admin/growth?days=' + days.value);
        $('growth-since').textContent = '수집 시작: ' + new Date(report.trackingSince).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) + ' · 과거 데이터 소급 없음 · 비율은 관찰 완료 대상만 집계';
        content.replaceChildren();
        const cards = node('div', null, 'admin-stats');
        for (const rate of report.rates) {
          const card = node('div', null, 'admin-stat');
          card.append(node('div', rateNames[rate.key] || rate.key, 'admin-stat-label'),
            node('div', rate.percent == null ? '집계 대기' : rate.percent.toFixed(1) + '%', 'admin-stat-value'),
            node('div', rate.converted + ' / ' + rate.eligible + (rate.key === 'answer_to_peer' ? ' 이용자·날짜' : '명'), 'admin-stat-hint'));
          cards.append(card);
        }
        content.append(cards, node('h2', '기간 내 행동'), node('p', '상호 연락처를 제공한 연결 ' + report.connectedPairs + '쌍 · 동일 연결은 한 번만 집계 · 답장·교환 지표는 약 1분 후 반영', 'growth-note'));
        const wrap = node('div', null, 'growth-table-wrap'), table = node('table'), head = node('thead'), tr = node('tr');
        for (const title of ['행동', '발생 수', '이용자 수']) { const th = node('th', title); th.scope = 'col'; tr.append(th); }
        head.append(tr); table.append(head);
        const body = node('tbody'), counts = new Map(report.counts.map(c => [c.event, c]));
        for (const [event, title] of Object.entries(names)) {
          const count = counts.get(event), row = node('tr');
          row.append(node('td', title), node('td', String(count?.events ?? 0)), node('td', String(count?.users ?? 0))); body.append(row);
        }
        table.append(body); wrap.append(table); content.append(wrap);
      } catch (error) {
        if (error.auth) return showLogin('어드민 권한이 있는 계정으로 로그인해 주세요.');
        window.admin.error(content, window.pageLoad);
      } finally { done(); days.disabled = false; }
    };
    document.getElementById('growth-days').addEventListener('change', () => window.pageLoad());
  </script>
</AdminLayout>
<style is:global>
  .growth-toolbar { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .growth-toolbar p { flex: 1; min-width: 210px; }
  .growth-toolbar select { margin-left: 8px; padding: 8px 12px; border-radius: 10px; background: var(--surface); color: var(--ink); border: 1px solid var(--border); }
  .growth-note { color: var(--muted); font-size: 14px; line-height: 1.8; margin: 12px 0 20px; }
  #growth-content .admin-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1000px) { #growth-content .admin-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  #growth-content h2 { margin: 32px 0 8px; }
  #growth-content .admin-stat-value { font-size: clamp(24px, 3vw, 36px); }
  .growth-table-wrap { overflow-x: auto; }
  .growth-table-wrap table { width: 100%; border-collapse: collapse; }
  .growth-table-wrap th, .growth-table-wrap td { text-align: left; padding: 14px 12px; border-bottom: 1px solid var(--border); }
  .growth-table-wrap th { color: var(--muted); font-size: 13px; }
  .growth-definitions { margin-top: 28px; padding: 20px; border: 1px solid var(--border); border-radius: 16px; }
  .growth-definitions summary { cursor: pointer; font-weight: 600; }
  .growth-definitions p { font-size: 14px; line-height: 1.9; color: var(--muted); margin-top: 14px; }
</style>
