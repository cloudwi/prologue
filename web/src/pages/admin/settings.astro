---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="앱 설정">
  <div class="admin-card">
    <p class="admin-note">
      <strong>최소 지원 버전</strong>을 올리면 그 미만 앱은 열리지 않고 스토어로 보내는 화면에 막혀요.
      올리기 전에 <strong>양쪽 스토어에 그 버전이 실제로 올라가 있는지</strong> 확인하세요 —
      한쪽이라도 비어 있으면 그 사람들은 갈 곳 없이 막혀요.
      되돌리려면 ‘기본값으로’를 누르면 즉시 풀려요.
    </p>
  </div>
  <div id="setting-list" class="admin-card admin-list"></div>

  <script is:inline>
    const LABEL = {
      'min-supported-version': '최소 지원 버전',
      'latest-version': '최신 버전',
    };
    const HINT = {
      'min-supported-version': '이 버전 미만은 앱이 열리지 않아요.',
      'latest-version': '스토어에 올라가 있는 최신 버전. 지금은 안내에만 써요.',
    };

    window.pageLoad = async function () {
      const { $, api, showLogin } = window.admin;
      const listEl = $('setting-list');
      listEl.textContent = '불러오는 중...';
      try {
        const data = await api('/admin/app-config');
        render(data.settings);
      } catch (e) {
        if (e.auth) return showLogin('어드민 권한이 있는 계정으로 로그인해 주세요.');
        listEl.textContent = e.message;
      }
    };

    // innerHTML 금지 — 값은 사람이 적는 것이라 전부 textContent·value로만 그린다.
    function render(items) {
      const { $ } = window.admin;
      const listEl = $('setting-list');
      listEl.textContent = '';

      for (const s of items) {
        const row = document.createElement('div');
        row.className = 'admin-row';

        const info = document.createElement('div');
        info.className = 'admin-row-info';
        const name = document.createElement('div');
        name.className = 'admin-row-name';
        name.textContent = LABEL[s.key] ?? s.key;
        const hint = document.createElement('div');
        hint.className = 'admin-row-date';
        hint.textContent = HINT[s.key] ?? '';
        const where = document.createElement('div');
        where.className = 'admin-row-date';
        /*
          지금 값이 어디서 왔는지 말해준다.

          이게 없으면 '기본값으로' 버튼이 무슨 뜻인지 알 수 없다 — 이미 기본값인데 누르는 일도,
          바꿔둔 줄 알았는데 아니었던 일도 생긴다.
        */
        where.textContent = s.overridden
          ? `여기서 정한 값이에요 (기본값 ${s.defaultValue})`
          : `기본값을 쓰고 있어요 (${s.defaultValue})`;
        info.append(name, hint, where);

        const actions = document.createElement('div');
        actions.className = 'admin-row-actions';

        const input = document.createElement('input');
        input.className = 'admin-input';
        input.value = s.value;
        input.placeholder = '1.3.0';
        input.size = 9;

        const save = document.createElement('button');
        save.className = 'admin-btn small';
        save.textContent = '저장';
        save.onclick = async () => {
          const value = input.value.trim();
          if (!/^\d+\.\d+\.\d+$/.test(value)) return alert('1.3.0 같은 꼴로 적어주세요.');
          if (s.key === 'min-supported-version'
            && !confirm(`최소 지원 버전을 ${value}로 올릴까요?\n\n${value} 미만 앱은 이 순간부터 열리지 않아요. 스토어에 ${value}가 올라가 있는지 먼저 확인하세요.`)) return;
          save.disabled = true;
          try {
            await window.admin.api('/admin/app-config/' + s.key, { method: 'PUT', body: JSON.stringify({ value }) });
            await window.pageLoad();
          } catch (e) { alert(e.message); save.disabled = false; }
        };

        const reset = document.createElement('button');
        reset.className = 'admin-btn ghost small';
        reset.textContent = '기본값으로';
        reset.disabled = !s.overridden;
        reset.onclick = async () => {
          if (!confirm(`기본값(${s.defaultValue})으로 되돌릴까요?`)) return;
          reset.disabled = true;
          try {
            await window.admin.api('/admin/app-config/' + s.key, { method: 'DELETE' });
            await window.pageLoad();
          } catch (e) { alert(e.message); reset.disabled = false; }
        };

        actions.append(input, save, reset);
        row.append(info, actions);
        listEl.append(row);
      }
    }
  </script>
</AdminLayout>
