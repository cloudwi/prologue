---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="모임 운영">
  <div id="meetup-list" class="admin-card admin-list"></div>

  <script is:inline>
    const MEETUP_STATUS = { OPEN: '모집 중', CLOSED: '모집 마감', DONE: '개최 완료', CANCELED: '취소됨' };

    window.pageLoad = async function () {
      const { $, api, showLogin } = window.admin;
      const listEl = $('meetup-list');
      listEl.textContent = '불러오는 중...';
      try {
        const data = await api('/admin/meetups');
        render(data.meetups);
      } catch (e) {
        if (e.auth) return showLogin('어드민 권한이 있는 계정으로 로그인해 주세요.');
        listEl.textContent = e.message;
      }
    };

    // innerHTML 금지 — 제목·닉네임은 사용자 입력이라 전부 textContent로만 그린다.
    function render(items) {
      const { $ } = window.admin;
      const listEl = $('meetup-list');
      listEl.textContent = '';
      if (!items.length) {
        listEl.textContent = '등록된 모임이 없어요.';
        return;
      }
      for (const m of items) {
        const row = document.createElement('div');
        row.className = 'admin-row';

        const info = document.createElement('div');
        info.className = 'admin-row-info';

        const name = document.createElement('div');
        name.className = 'admin-row-name';
        name.textContent = m.title;
        const badge = document.createElement('span');
        badge.className = 'admin-badge' + (m.status === 'OPEN' ? ' ok' : m.status === 'CANCELED' ? ' warn' : '');
        badge.textContent = MEETUP_STATUS[m.status] || m.status;
        name.append(' ', badge);
        if (m.coverUrls && m.coverUrls.length > 0) {
          const cover = document.createElement('span');
          cover.className = 'admin-badge';
          cover.textContent = '사진 ' + m.coverUrls.length;
          name.append(' ', cover);
        }

        const meta = document.createElement('div');
        meta.className = 'admin-row-date';
        const fee = m.feeFemale != null && m.feeFemale !== m.fee
          ? '남 ' + m.fee.toLocaleString() + '원·여 ' + (m.feeFemale > 0 ? m.feeFemale.toLocaleString() + '원' : '무료')
          : m.fee > 0 ? m.fee.toLocaleString() + '원' : '무료';
        meta.textContent =
          new Date(m.meetAt).toLocaleString('ko-KR') + ' · ' + m.place + ' · ' + fee +
          ' · 확정 ' + m.confirmedCount + '/' + m.capacity + '명(신청 ' + m.appliedCount + ')';

        const host = document.createElement('div');
        host.className = 'admin-row-date';
        host.textContent = '모임장 ' + (m.hostNickname || '(알 수 없음)') + ' · 등록 ' + new Date(m.createdAt).toLocaleDateString('ko-KR');

        info.append(name, meta, host);

        const actions = document.createElement('div');
        actions.className = 'admin-row-actions';

        if (m.coverUrls && m.coverUrls.length > 0) {
          const photos = document.createElement('button');
          photos.className = 'admin-btn ghost small';
          photos.textContent = '사진 보기';
          photos.onclick = () => m.coverUrls.forEach((u) => window.open(u, '_blank', 'noopener'));
          actions.append(photos);
        }
        if (m.status === 'OPEN' || m.status === 'CLOSED') {
          const cancel = document.createElement('button');
          cancel.className = 'admin-btn ghost small';
          cancel.textContent = '강제 취소';
          cancel.onclick = () => {
            if (confirm("'" + m.title + "' 모임을 취소할까요? 신청자에게 취소 알림이 가요.")) act(m.meetupId, 'cancel', cancel);
          };
          actions.append(cancel);
        }
        const del = document.createElement('button');
        del.className = 'admin-btn ghost small';
        del.textContent = '삭제';
        del.onclick = () => {
          if (confirm("'" + m.title + "' 모임을 완전히 삭제할까요? 신청 기록·커버 사진까지 지워지고 되돌릴 수 없어요.")) {
            act(m.meetupId, 'delete', del);
          }
        };
        actions.append(del);

        row.append(info, actions);
        listEl.append(row);
      }
    }

    async function act(meetupId, action, btn) {
      const { api } = window.admin;
      btn.disabled = true;
      try {
        if (action === 'delete') await api('/admin/meetups/' + meetupId, { method: 'DELETE' });
        else await api('/admin/meetups/' + meetupId + '/' + action, { method: 'POST' });
        await window.pageLoad();
      } catch (e) {
        alert(e.message);
        btn.disabled = false;
      }
    }
  </script>
</AdminLayout>
