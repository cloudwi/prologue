---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="모임 운영">
  <div id="meetup-list" class="admin-card admin-list"></div>

  <script is:inline>
    const MEETUP_STATUS = {
      PENDING: '심사 대기', REJECTED: '반려됨',
      OPEN: '모집 중', CLOSED: '모집 마감', DONE: '개최 완료', CANCELED: '취소됨',
    };

    window.pageLoad = async function () {
      const { $, api, showLogin } = window.admin;
      const listEl = $('meetup-list');
      listEl.textContent = '불러오는 중...';
      try {
        const data = await api('/admin/meetups');
        /*
          할 일이 먼저 보여야 한다 — 사람 손을 기다리는 줄을 맨 위로 올린다.

          후기 심사도 그 줄이다. 다만 후기는 모임이 끝난 **뒤에** 올라오므로 그 모임의
          status는 이미 DONE이고, 상태만 보고 정렬하면 목록 아래에 묻힌다.
        */
        const order = { PENDING: 0, REJECTED: 1 };
        const rank = (m) => (m.recapStatus === 'PENDING' ? 0 : (order[m.status] ?? 2));
        render([...data.meetups].sort((a, b) => rank(a) - rank(b)));
      } catch (e) {
        if (e.auth) return showLogin('어드민 권한이 있는 계정으로 로그인해 주세요.');
        listEl.textContent = e.message;
      }
    };

    // innerHTML 금지 — 제목·닉네임은 사용자 입력이라 전부 textContent로만 그린다.
    function render(items) {
      const { $ } = window.admin;
      const listEl = $('meetup-list');
      listEl.textContent = '';
      if (!items.length) {
        listEl.textContent = '등록된 모임이 없어요.';
        return;
      }
      for (const m of items) {
        const row = document.createElement('div');
        row.className = 'admin-row';

        const info = document.createElement('div');
        info.className = 'admin-row-info';

        const name = document.createElement('div');
        name.className = 'admin-row-name';
        name.textContent = m.title;
        const badge = document.createElement('span');
        badge.className = 'admin-badge' +
          (m.status === 'OPEN' ? ' ok' : (m.status === 'CANCELED' || m.status === 'REJECTED' || m.status === 'PENDING') ? ' warn' : '');
        badge.textContent = MEETUP_STATUS[m.status] || m.status;
        name.append(' ', badge);
        if (m.coverUrls && m.coverUrls.length > 0) {
          const cover = document.createElement('span');
          cover.className = 'admin-badge';
          cover.textContent = '사진 ' + m.coverUrls.length;
          name.append(' ', cover);
        }

        const meta = document.createElement('div');
        meta.className = 'admin-row-date';
        const fee = m.feeFemale != null && m.feeFemale !== m.fee
          ? '남 ' + m.fee.toLocaleString() + '원·여 ' + (m.feeFemale > 0 ? m.feeFemale.toLocaleString() + '원' : '무료')
          : m.fee > 0 ? m.fee.toLocaleString() + '원' : '무료';
        meta.textContent =
          new Date(m.meetAt).toLocaleString('ko-KR') + ' · ' + m.place + ' · ' + fee +
          ' · 확정 ' + m.confirmedCount + '/' + m.capacity + '명(신청 ' + m.appliedCount + ')';

        const host = document.createElement('div');
        host.className = 'admin-row-date';
        host.textContent = '모임장 ' + (m.hostNickname || '(알 수 없음)') + ' · 등록 ' + new Date(m.createdAt).toLocaleDateString('ko-KR');

        info.append(name, meta, host);

        /*
          심사에 필요한 것을 함께 편다.

          제목과 날짜만 보고 승인하면 심사가 아니라 결재다. 소개 글·주소·오픈채팅 링크가
          그 자리에 있어야 "이 모임이 실재하는가"를 판단할 수 있다. 반려 사유도 여기 남는다.
        */
        if (m.status === 'PENDING' || m.status === 'REJECTED') {
          if (m.placeAddress) {
            const addr = document.createElement('div');
            addr.className = 'admin-row-date';
            addr.textContent = '주소 ' + m.placeAddress;
            info.append(addr);
          }
          const link = document.createElement('div');
          link.className = 'admin-row-date';
          link.textContent = '오픈채팅 ' + m.kakaoLink;
          info.append(link);
          if (m.description) {
            const desc = document.createElement('div');
            desc.className = 'admin-review-desc';
            desc.textContent = m.description;
            info.append(desc);
          }
          if (m.reviewNote) {
            const note = document.createElement('div');
            note.className = 'admin-row-date';
            note.textContent = '반려 사유: ' + m.reviewNote;
            info.append(note);
          }
        }

        /*
          후기 심사 — 모임 심사와 같은 이유로 글과 사진을 그 자리에 편다.

          후기는 모임이 끝난 **뒤에** 올라오므로 모임 자체는 이미 DONE이다. 그래서 모임
          상태(status)로는 이 줄이 손을 기다리고 있다는 사실이 드러나지 않는다.
        */
        if (m.recapStatus && m.recapStatus !== 'NONE') {
          const head = document.createElement('div');
          head.className = 'admin-row-date';
          const label = { PENDING: '심사 대기', APPROVED: '공개 중', REJECTED: '반려됨' }[m.recapStatus];
          head.textContent = '후기 · ' + label;
          info.append(head);
          if (m.recap) {
            const body = document.createElement('div');
            body.className = 'admin-review-desc';
            body.textContent = m.recap;
            info.append(body);
          }
          if (m.recapImageUrls && m.recapImageUrls.length > 0) {
            const shots = document.createElement('div');
            shots.className = 'admin-row-date';
            shots.textContent = '후기 사진 ' + m.recapImageUrls.length + '장';
            info.append(shots);
          }
          if (m.recapReviewNote) {
            const note = document.createElement('div');
            note.className = 'admin-row-date';
            note.textContent = '후기 반려 사유: ' + m.recapReviewNote;
            info.append(note);
          }
        }

        const actions = document.createElement('div');
        actions.className = 'admin-row-actions';

        if (m.coverUrls && m.coverUrls.length > 0) {
          const photos = document.createElement('button');
          photos.className = 'admin-btn ghost small';
          photos.textContent = '사진 보기';
          photos.onclick = () => m.coverUrls.forEach((u) => window.open(u, '_blank', 'noopener'));
          actions.append(photos);
        }
        if (m.status === 'PENDING') {
          const ok = document.createElement('button');
          ok.className = 'admin-btn small';
          ok.textContent = '승인';
          ok.onclick = () => {
            if (confirm("'" + m.title + "' 모임을 승인할까요? 승인하면 앱 모임 탭에 바로 실려요.")) act(m.meetupId, 'approve', ok);
          };
          const no = document.createElement('button');
          no.className = 'admin-btn ghost small';
          no.textContent = '반려';
          no.onclick = async () => {
            // 사유는 필수다 — 없으면 같은 모임이 그대로 다시 올라온다.
            const reason = prompt('반려 사유를 적어주세요. 모임장에게 그대로 보여요.');
            if (reason == null || !reason.trim()) return;
            no.disabled = true;
            try {
              await window.admin.api('/admin/meetups/' + m.meetupId + '/reject', {
                method: 'POST',
                body: JSON.stringify({ reason: reason.trim() }),
              });
              await window.pageLoad();
            } catch (e) { alert(e.message); no.disabled = false; }
          };
          actions.append(ok, no);
        }
        if (m.recapStatus === 'PENDING') {
          if (m.recapImageUrls && m.recapImageUrls.length > 0) {
            const shots = document.createElement('button');
            shots.className = 'admin-btn ghost small';
            shots.textContent = '후기 사진';
            shots.onclick = () => m.recapImageUrls.forEach((u) => window.open(u, '_blank', 'noopener'));
            actions.append(shots);
          }
          const ok = document.createElement('button');
          ok.className = 'admin-btn small';
          ok.textContent = '후기 승인';
          ok.onclick = () => {
            if (confirm("'" + m.title + "' 후기를 승인할까요? 앱의 지난 모임과 초대장에 실려요.")) {
              act(m.meetupId, 'recap/approve', ok);
            }
          };
          const no = document.createElement('button');
          no.className = 'admin-btn ghost small';
          no.textContent = '후기 반려';
          no.onclick = async () => {
            // 사유는 필수다 — 없으면 같은 글이 그대로 다시 올라온다.
            const reason = prompt('후기 반려 사유를 적어주세요. 모임장에게 그대로 보여요.');
            if (reason == null || !reason.trim()) return;
            no.disabled = true;
            try {
              await window.admin.api('/admin/meetups/' + m.meetupId + '/recap/reject', {
                method: 'POST',
                body: JSON.stringify({ reason: reason.trim() }),
              });
              await window.pageLoad();
            } catch (e) { alert(e.message); no.disabled = false; }
          };
          actions.append(ok, no);
        }
        if (m.status === 'OPEN' || m.status === 'CLOSED') {
          const cancel = document.createElement('button');
          cancel.className = 'admin-btn ghost small';
          cancel.textContent = '강제 취소';
          cancel.onclick = () => {
            if (confirm("'" + m.title + "' 모임을 취소할까요? 신청자에게 취소 알림이 가요.")) act(m.meetupId, 'cancel', cancel);
          };
          actions.append(cancel);
        }
        const del = document.createElement('button');
        del.className = 'admin-btn ghost small';
        del.textContent = '삭제';
        del.onclick = () => {
          if (confirm("'" + m.title + "' 모임을 완전히 삭제할까요? 신청 기록·커버 사진까지 지워지고 되돌릴 수 없어요.")) {
            act(m.meetupId, 'delete', del);
          }
        };
        actions.append(del);

        row.append(info, actions);
        listEl.append(row);
      }
    }

    async function act(meetupId, action, btn) {
      const { api } = window.admin;
      btn.disabled = true;
      try {
        if (action === 'delete') await api('/admin/meetups/' + meetupId, { method: 'DELETE' });
        else await api('/admin/meetups/' + meetupId + '/' + action, { method: 'POST' });
        await window.pageLoad();
      } catch (e) {
        alert(e.message);
        btn.disabled = false;
      }
    }
  </script>
</AdminLayout>
