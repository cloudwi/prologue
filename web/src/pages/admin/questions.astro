---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="질문 관리">
  <div class="admin-field" style="margin: 0 0 12px;">
    <input id="new-question" type="text" maxlength="500" placeholder="새 질문 (예: 관계에서 끝까지 지키고 싶은 한 가지는 무엇인가요?)" />
    <button type="button" class="admin-btn" id="add-question">추가</button>
  </div>
  <p class="admin-desc" style="margin: 0 0 12px;">
    질문은 id 순서로 날짜에 따라 순환해요. 질문을 추가하면 주기가 바뀌어 오늘의 질문이 달라질 수 있어요. 삭제는 없고 문구 수정만 돼요(답변들이 질문을 참조해요).
  </p>
  <div class="admin-field" style="margin: 0 0 8px;">
    <input id="question-filter" type="search" placeholder="질문 찾기 (문구 또는 번호)" autocomplete="off" />
    <button type="button" class="admin-btn ghost" id="goto-today">오늘의 질문</button>
  </div>
  <p class="admin-desc" id="question-count" style="margin: 0 0 12px;"></p>
  <div id="question-list" class="admin-card admin-list"></div>

  <script is:inline>
    window.pageLoad = async function () {
      const { $, api, showLogin } = window.admin;
      const listEl = $('question-list');
      if (listEl.getAttribute('aria-busy') === 'true') return;
      const done = window.admin.loading(listEl, {});
      try {
        const data = await api('/admin/questions');
        window.__questions = data.questions;
        applyFilter();
      } catch (e) {
        if (e.auth) return showLogin('어드민 권한이 있는 계정으로 로그인해 주세요.');
        window.admin.error(listEl, window.pageLoad);
      } finally {
        done();
      }
    };

    // innerHTML 금지 — 질문 문구도 입력값이라 전부 textContent로만 그린다.
    function render(items) {
      const { $ } = window.admin;
      const listEl = $('question-list');
      const all = window.__questions || items;
      $('question-count').textContent =
        items.length === all.length
          ? '질문 ' + all.length + '개'
          : '질문 ' + all.length + '개 중 ' + items.length + '개';
      listEl.textContent = '';
      if (!items.length) {
        window.admin.empty(listEl, '찾는 질문이 없어요.');
        return;
      }
      for (const q of items) {
        const row = document.createElement('div');
        row.className = 'admin-row';

        const info = document.createElement('div');
        info.className = 'admin-row-info';
        const name = document.createElement('div');
        name.className = 'admin-row-name';
        name.textContent = 'Q' + q.id + (q.isToday ? ' · 오늘의 질문' : '');
        const content = document.createElement('div');
        content.className = 'admin-snapshot';
        content.textContent = q.content;
        info.append(name, content);

        const actions = document.createElement('div');
        actions.className = 'admin-row-actions';
        const edit = document.createElement('button');
        edit.className = 'admin-btn ghost small';
        edit.textContent = '수정';
        edit.onclick = () => {
          const next = prompt('질문 문구를 수정해 주세요.', q.content);
          if (next != null && next.trim() && next.trim() !== q.content) save(q.id, next.trim(), edit);
        };
        actions.append(edit);

        row.append(info, actions);
        listEl.append(row);
      }
    }

    async function save(id, content, btn) {
      const { api, showLogin } = window.admin;
      btn.disabled = true;
      try {
        await api('/admin/questions/' + id, { method: 'PUT', body: JSON.stringify({ content }) });
        await window.pageLoad();
      } catch (e) {
        if (e.auth) return showLogin('세션이 만료됐어요. 다시 로그인해 주세요.');
        alert(e.message);
        btn.disabled = false;
      }
    }

    // 풀이 1,000개라 전부 그려두고 화면에서만 걸러낸다 — 어드민은 문구 수정이 일이라
    // 서버 검색까지 둘 만큼 무겁지 않다.
    function applyFilter() {
      const term = document.getElementById('question-filter').value.trim().toLowerCase();
      const all = window.__questions || [];
      if (!term) return render(all);
      render(all.filter((q) => String(q.id) === term || q.content.toLowerCase().includes(term)));
    }

    document.getElementById('question-filter').addEventListener('input', applyFilter);

    document.getElementById('goto-today').addEventListener('click', () => {
      const today = (window.__questions || []).find((q) => q.isToday);
      if (!today) return;
      document.getElementById('question-filter').value = String(today.id);
      applyFilter();
    });

    document.getElementById('add-question').addEventListener('click', async () => {
      const { $, api, showLogin } = window.admin;
      const input = $('new-question');
      const content = input.value.trim();
      if (!content) return;
      try {
        await api('/admin/questions', { method: 'POST', body: JSON.stringify({ content }) });
        input.value = '';
        await window.pageLoad();
      } catch (e) {
        if (e.auth) return showLogin('세션이 만료됐어요. 다시 로그인해 주세요.');
        alert(e.message);
      }
    });
  </script>
</AdminLayout>
