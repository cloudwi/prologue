---
import AdminLayout from '../../layouts/AdminLayout.astro';

// 모임장 콘솔 — 모임을 만들고, 신청자를 보고, (카카오에서 입금을 확인한 뒤) 확정한다.
// 권한: ROLE_HOST(운영자가 어드민 > 회원에서 지정) 또는 ADMIN. 지정 후 재로그인해야 롤이 실린다.
const tabs = [{ href: '/host', label: '내 모임' }];
---

<AdminLayout title="모임장 콘솔" tabs={tabs} brandSuffix="모임장" home="/host">
  <p class="admin-desc" style="margin: 0 0 16px;">
    참가비 입금과 대화는 내 카카오 오픈채팅에서 이뤄져요. 입금을 확인한 신청자에게 여기서 "확정"을 눌러주세요.
    모임을 마친 뒤 "개최 완료"를 누르면 개최 기록이 쌓여 앱에서 신뢰 신호로 보여요.
  </p>

  <!-- 새 모임 -->
  <div class="admin-card" style="margin-bottom: 18px;">
    <h3 class="host-form-title">새 모임 만들기</h3>
    <div class="host-form">
      <input id="mt-title" placeholder="모임 이름 (예: 한강 러닝 후 브런치)" maxlength="80" />
      <div class="host-form-row">
        <input id="mt-at" type="datetime-local" />
        <input id="mt-place" placeholder="장소 (예: 뚝섬유원지 2번 출구)" maxlength="120" />
      </div>
      <div class="host-form-row">
        <input id="mt-capacity" type="number" min="2" max="100" placeholder="정원 (명)" />
        <input id="mt-fee" type="number" min="0" step="1000" placeholder="참가비 (원, 무료면 0)" />
      </div>
      <input id="mt-kakao" placeholder="카카오 오픈채팅 링크 (https://open.kakao.com/...)" maxlength="300" />
      <textarea id="mt-desc" placeholder="소개 — 어떤 모임인지, 입금 안내는 오픈채팅에서 한다는 것까지." maxlength="1000" rows="3"></textarea>
      <button type="button" class="admin-btn" id="mt-create">모임 만들기</button>
      <p class="admin-msg" id="mt-msg"></p>
    </div>
  </div>

  <div id="meetup-list"></div>

  <script is:inline>
    const MEETUP_STATUS = { OPEN: '모집 중', CLOSED: '모집 마감', DONE: '개최 완료', CANCELED: '취소됨' };
    const APP_STATUS = { APPLIED: '신청', CONFIRMED: '확정', DECLINED: '거절', CANCELED: '신청자 취소' };
    const GENDER = { MALE: '남', FEMALE: '여' };

    window.pageLoad = async function () {
      const { $, api, showLogin } = window.admin;
      const listEl = $('meetup-list');
      listEl.textContent = '불러오는 중...';
      try {
        const data = await api('/host/meetups');
        render(data.meetups);
      } catch (e) {
        if (e.auth) return showLogin('모임장 권한이 있는 계정으로 로그인해 주세요. (지정 직후라면 다시 로그인해야 해요)');
        listEl.textContent = e.message;
      }
    };

    // innerHTML 금지 — 닉네임 등 사용자 입력은 전부 textContent로만 그린다.
    function render(items) {
      const { $ } = window.admin;
      const listEl = $('meetup-list');
      listEl.textContent = '';
      if (!items.length) {
        listEl.textContent = '아직 만든 모임이 없어요. 위에서 첫 모임을 만들어보세요.';
        return;
      }
      for (const m of items) {
        const card = document.createElement('div');
        card.className = 'admin-card admin-photo-card';

        const head = document.createElement('div');
        head.className = 'admin-row-name';
        const t = document.createElement('span');
        t.textContent = m.title;
        const badge = document.createElement('span');
        badge.className = 'admin-badge' + (m.status === 'OPEN' ? ' ok' : m.status === 'CANCELED' ? ' warn' : '');
        badge.textContent = MEETUP_STATUS[m.status] || m.status;
        head.append(t, badge);
        card.append(head);

        const meta = document.createElement('div');
        meta.className = 'admin-row-date';
        meta.textContent =
          new Date(m.meetAt).toLocaleString('ko-KR') + ' · ' + m.place +
          ' · 확정 ' + m.confirmedCount + '/' + m.capacity + '명' +
          (m.fee > 0 ? ' · 참가비 ' + m.fee.toLocaleString('ko-KR') + '원' : ' · 무료');
        card.append(meta);

        if (m.description) {
          const desc = document.createElement('div');
          desc.className = 'admin-snapshot';
          desc.textContent = m.description;
          card.append(desc);
        }

        // 모임 상태 버튼 — 상태에 따라 다음 할 일만 보여준다
        const actions = document.createElement('div');
        actions.className = 'admin-row-actions';
        actions.style.marginTop = '12px';
        const act = (label, path, confirmMsg, primary) => {
          const btn = document.createElement('button');
          btn.className = 'admin-btn small' + (primary ? '' : ' ghost');
          btn.textContent = label;
          btn.onclick = () => {
            if (!confirmMsg || confirm(confirmMsg)) meetupAction('/host/meetups/' + m.meetupId + path, btn);
          };
          return btn;
        };
        if (m.status === 'OPEN') actions.append(act('모집 마감', '/close'), act('개최 완료', '/complete', '모임을 개최 완료로 기록할까요?', true), act('모임 취소', '/cancel', '모임을 취소할까요? 신청자에게 카카오로 알려주세요.'));
        if (m.status === 'CLOSED') actions.append(act('다시 열기', '/reopen'), act('개최 완료', '/complete', '모임을 개최 완료로 기록할까요?', true), act('모임 취소', '/cancel', '모임을 취소할까요? 신청자에게 카카오로 알려주세요.'));
        if (actions.childNodes.length) card.append(actions);

        // 신청자 목록
        const appsHead = document.createElement('div');
        appsHead.className = 'admin-row-date';
        appsHead.style.marginTop = '14px';
        appsHead.textContent = '신청자 ' + m.applications.length + '명 — 입금을 확인한 분에게만 확정을 눌러주세요';
        card.append(appsHead);
        for (const a of m.applications) {
          const row = document.createElement('div');
          row.className = 'admin-row';
          const info = document.createElement('div');
          info.className = 'admin-row-info';
          const name = document.createElement('div');
          name.className = 'admin-row-name';
          const nick = document.createElement('span');
          nick.textContent =
            (a.nickname || '(프로필 없음)') +
            (a.gender ? ' · ' + (GENDER[a.gender] || a.gender) : '') +
            (a.age ? ' · 만 ' + a.age + '세' : '') +
            (a.region ? ' · ' + a.region : '');
          const st = document.createElement('span');
          st.className = 'admin-badge' + (a.status === 'CONFIRMED' ? ' ok' : a.status === 'APPLIED' ? '' : ' warn');
          st.textContent = APP_STATUS[a.status] || a.status;
          name.append(nick, st);
          const when = document.createElement('div');
          when.className = 'admin-row-date';
          when.textContent = '신청 ' + new Date(a.appliedAt).toLocaleString('ko-KR');
          info.append(name, when);

          const rowActions = document.createElement('div');
          rowActions.className = 'admin-row-actions';
          if (a.status === 'APPLIED' || a.status === 'DECLINED') {
            const ok = document.createElement('button');
            ok.className = 'admin-btn small';
            ok.textContent = '확정';
            ok.onclick = () => meetupAction('/host/meetups/applications/' + a.applicationId + '/confirm', ok);
            rowActions.append(ok);
          }
          if (a.status === 'APPLIED' || a.status === 'CONFIRMED') {
            const no = document.createElement('button');
            no.className = 'admin-btn ghost small';
            no.textContent = '거절';
            no.onclick = () => {
              if (confirm((a.nickname || '이 신청자') + ' 님을 거절할까요?')) meetupAction('/host/meetups/applications/' + a.applicationId + '/decline', no);
            };
            rowActions.append(no);
          }
          row.append(info, rowActions);
          card.append(row);
        }

        listEl.append(card);
      }
    }

    async function meetupAction(path, btn) {
      const { api, showLogin } = window.admin;
      btn.disabled = true;
      try {
        await api(path, { method: 'POST' });
        await window.pageLoad();
      } catch (e) {
        if (e.auth) return showLogin('세션이 만료됐어요. 다시 로그인해 주세요.');
        alert(e.message);
        btn.disabled = false;
      }
    }

    document.getElementById('mt-create').addEventListener('click', async () => {
      const { $, api, showLogin } = window.admin;
      const msg = $('mt-msg');
      const at = $('mt-at').value;
      const body = {
        title: $('mt-title').value.trim(),
        description: $('mt-desc').value.trim() || null,
        meetAt: at ? new Date(at).toISOString() : '',
        place: $('mt-place').value.trim(),
        capacity: Number($('mt-capacity').value),
        fee: Number($('mt-fee').value || 0),
        kakaoLink: $('mt-kakao').value.trim(),
      };
      if (!body.title || !at || !body.place || !body.capacity || !body.kakaoLink) {
        msg.textContent = '이름·일시·장소·정원·카카오 링크는 필수예요.';
        return;
      }
      const btn = document.getElementById('mt-create');
      btn.disabled = true;
      msg.textContent = '';
      try {
        await api('/host/meetups', { method: 'POST', body: JSON.stringify(body) });
        for (const id of ['mt-title', 'mt-at', 'mt-place', 'mt-capacity', 'mt-fee', 'mt-kakao', 'mt-desc']) $(id).value = '';
        msg.textContent = '모임을 만들었어요. 앱의 모임 탭에 바로 보여요.';
        await window.pageLoad();
      } catch (e) {
        if (e.auth) return showLogin('모임장 권한이 있는 계정으로 로그인해 주세요.');
        msg.textContent = e.message;
      } finally {
        btn.disabled = false;
      }
    });
  </script>

  <style is:global>
    .host-form-title {
      font-size: 15px;
      font-weight: 800;
      margin-bottom: 12px;
    }
    .host-form {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .host-form input,
    .host-form textarea {
      height: 42px;
      padding: 0 14px;
      font-size: 14.5px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--surface);
      color: var(--ink);
      font-family: inherit;
    }
    .host-form textarea {
      height: auto;
      padding: 11px 14px;
      resize: vertical;
      line-height: 1.5;
    }
    .host-form-row {
      display: flex;
      gap: 8px;
    }
    .host-form-row input {
      flex: 1;
      min-width: 0;
    }
    .host-form .admin-btn {
      align-self: flex-start;
      margin-top: 4px;
    }
  </style>
</AdminLayout>
